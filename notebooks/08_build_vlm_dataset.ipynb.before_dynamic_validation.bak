   "source": [
    "# =============================================================================\n",
    "# NOTEBOOK 08 — CELL 2\n",
    "# GENERATE MODEL-READY PNG IMAGERY\n",
    "# =============================================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import hashlib\n",
    "import json\n",
    "import warnings\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import rasterio\n",
    "from PIL import Image\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=RuntimeWarning)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 1. PROJECT PATHS\n",
    "# =============================================================================\n",
    "\n",
    "PROJECT_ROOT = Path(\n",
    "    r\"C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\"\n",
    ")\n",
    "\n",
    "VLM_DATASET_DIR = PROJECT_ROOT / \"data\" / \"processed\" / \"vlm_dataset\"\n",
    "\n",
    "MASTER_DIR = VLM_DATASET_DIR / \"master\"\n",
    "MANIFEST_DIR = VLM_DATASET_DIR / \"manifests\"\n",
    "VALIDATION_DIR = VLM_DATASET_DIR / \"validation\"\n",
    "\n",
    "IMAGE_ROOT = VLM_DATASET_DIR / \"images\"\n",
    "S2_RGB_DIR = IMAGE_ROOT / \"sentinel2_rgb\"\n",
    "S1_VIS_DIR = IMAGE_ROOT / \"sentinel1_visualization\"\n",
    "\n",
    "SCENE_MANIFEST_PATH = MASTER_DIR / \"scene_multimodal_manifest.csv\"\n",
    "\n",
    "for directory in [\n",
    "    MASTER_DIR,\n",
    "    MANIFEST_DIR,\n",
    "    VALIDATION_DIR,\n",
    "    IMAGE_ROOT,\n",
    "    S2_RGB_DIR,\n",
    "    S1_VIS_DIR,\n",
    "]:\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"NOTEBOOK 08: MODEL-READY IMAGE GENERATION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\nDIRECTORIES\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Project root          : {PROJECT_ROOT}\")\n",
    "print(f\"Scene manifest        : {SCENE_MANIFEST_PATH}\")\n",
    "print(f\"Sentinel-2 RGB output : {S2_RGB_DIR}\")\n",
    "print(f\"Sentinel-1 output     : {S1_VIS_DIR}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 2. LOAD AND VALIDATE THE SCENE MANIFEST\n",
    "# =============================================================================\n",
    "\n",
    "if not SCENE_MANIFEST_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        \"The multimodal scene manifest was not found. \"\n",
    "        \"Rerun Notebook 08 Cell 1 before running this cell.\\n\"\n",
    "        f\"Expected path: {SCENE_MANIFEST_PATH}\"\n",
    "    )\n",
    "\n",
    "scene_manifest_df = pd.read_csv(\n",
    "    SCENE_MANIFEST_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "if \"scene_id\" not in scene_manifest_df.columns:\n",
    "    raise ValueError(\n",
    "        \"scene_multimodal_manifest.csv does not contain a scene_id column.\"\n",
    "    )\n",
    "\n",
    "if scene_manifest_df[\"scene_id\"].duplicated().any():\n",
    "    duplicate_scenes = (\n",
    "        scene_manifest_df.loc[\n",
    "            scene_manifest_df[\"scene_id\"].duplicated(keep=False),\n",
    "            \"scene_id\",\n",
    "        ]\n",
    "        .unique()\n",
    "        .tolist()\n",
    "    )\n",
    "    raise ValueError(\n",
    "        f\"Duplicate scene IDs were found in the manifest: {duplicate_scenes}\"\n",
    "    )\n",
    "\n",
    "required_scenes = sorted(\n",
    "    scene_manifest_df[\"scene_id\"].astype(str).str.strip().tolist()\n",
    ")\n",
    "\n",
    "print(\"\\nSCENE MANIFEST\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Manifest records : {len(scene_manifest_df):,}\")\n",
    "print(f\"Unique scenes    : {scene_manifest_df['scene_id'].nunique():,}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 3. RESOLVE SOURCE-RASTER PATHS\n",
    "# =============================================================================\n",
    "# The manifest may use slightly different path column names depending on the\n",
    "# earlier notebook version. These candidate lists make the cell robust.\n",
    "\n",
    "S2_PATH_CANDIDATES = [\n",
    "    \"s2_image_path\",\n",
    "    \"s2_path\",\n",
    "    \"sentinel2_path\",\n",
    "    \"sentinel_2_path\",\n",
    "    \"primary_image_path\",\n",
    "    \"primary_raster_path\",\n",
    "    \"S2Hand_path\",\n",
    "    \"s2hand_path\",\n",
    "]\n",
    "\n",
    "S1_PATH_CANDIDATES = [\n",
    "    \"s1_image_path\",\n",
    "    \"s1_path\",\n",
    "    \"sentinel1_path\",\n",
    "    \"sentinel_1_path\",\n",
    "    \"S1Hand_path\",\n",
    "    \"s1hand_path\",\n",
    "]\n",
    "\n",
    "RAW_S2_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    "    / \"raw\"\n",
    "    / \"sen1floods11\"\n",
    "    / \"hand_labeled\"\n",
    "    / \"S2Hand\"\n",
    ")\n",
    "\n",
    "RAW_S1_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    "    / \"raw\"\n",
    "    / \"sen1floods11\"\n",
    "    / \"hand_labeled\"\n",
    "    / \"S1Hand\"\n",
    ")\n",
    "\n",
    "\n",
    "def first_existing_column(dataframe, candidates):\n",
    "    \"\"\"Return the first candidate column present in a dataframe.\"\"\"\n",
    "\n",
    "    for column in candidates:\n",
    "        if column in dataframe.columns:\n",
    "            return column\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def normalize_source_path(value, project_root):\n",
    "    \"\"\"\n",
    "    Convert a stored path value to an absolute Path.\n",
    "\n",
    "    Supports:\n",
    "    - absolute Windows paths;\n",
    "    - project-relative paths;\n",
    "    - slash-normalized paths.\n",
    "    \"\"\"\n",
    "\n",
    "    text = str(value).strip()\n",
    "\n",
    "    if not text:\n",
    "        return None\n",
    "\n",
    "    path = Path(text)\n",
    "\n",
    "    if path.is_absolute():\n",
    "        return path\n",
    "\n",
    "    return project_root / path\n",
    "\n",
    "\n",
    "def resolve_scene_raster(\n",
    "    row,\n",
    "    scene_id,\n",
    "    path_column,\n",
    "    component_directory,\n",
    "    component_name,\n",
    "):\n",
    "    \"\"\"\n",
    "    Resolve a scene raster from the manifest first, then from the expected\n",
    "    raw-data directory.\n",
    "    \"\"\"\n",
    "\n",
    "    candidates = []\n",
    "\n",
    "    if path_column is not None:\n",
    "        manifest_path = normalize_source_path(\n",
    "            row.get(path_column, \"\"),\n",
    "            PROJECT_ROOT,\n",
    "        )\n",
    "\n",
    "        if manifest_path is not None:\n",
    "            candidates.append(manifest_path)\n",
    "\n",
    "    candidates.extend(\n",
    "        [\n",
    "            component_directory / f\"{scene_id}_{component_name}.tif\",\n",
    "            component_directory / f\"{scene_id}_{component_name}.tiff\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    # Recursive fallback in case a file is stored in a nested directory.\n",
    "    candidates.extend(\n",
    "        component_directory.rglob(f\"{scene_id}_{component_name}.tif\")\n",
    "    )\n",
    "    candidates.extend(\n",
    "        component_directory.rglob(f\"{scene_id}_{component_name}.tiff\")\n",
    "    )\n",
    "\n",
    "    seen = set()\n",
    "\n",
    "    for candidate in candidates:\n",
    "        candidate = Path(candidate)\n",
    "        candidate_key = str(candidate).lower()\n",
    "\n",
    "        if candidate_key in seen:\n",
    "            continue\n",
    "\n",
    "        seen.add(candidate_key)\n",
    "\n",
    "        if candidate.exists() and candidate.is_file():\n",
    "            return candidate.resolve()\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "s2_manifest_column = first_existing_column(\n",
    "    scene_manifest_df,\n",
    "    S2_PATH_CANDIDATES,\n",
    ")\n",
    "\n",
    "s1_manifest_column = first_existing_column(\n",
    "    scene_manifest_df,\n",
    "    S1_PATH_CANDIDATES,\n",
    ")\n",
    "\n",
    "print(\"\\nPATH-COLUMN DISCOVERY\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Sentinel-2 manifest column : {s2_manifest_column}\")\n",
    "print(f\"Sentinel-1 manifest column : {s1_manifest_column}\")\n",
    "\n",
    "\n",
    "resolved_source_records = []\n",
    "\n",
    "for _, row in scene_manifest_df.iterrows():\n",
    "    scene_id = str(row[\"scene_id\"]).strip()\n",
    "\n",
    "    s2_source_path = resolve_scene_raster(\n",
    "        row=row,\n",
    "        scene_id=scene_id,\n",
    "        path_column=s2_manifest_column,\n",
    "        component_directory=RAW_S2_DIR,\n",
    "        component_name=\"S2Hand\",\n",
    "    )\n",
    "\n",
    "    s1_source_path = resolve_scene_raster(\n",
    "        row=row,\n",
    "        scene_id=scene_id,\n",
    "        path_column=s1_manifest_column,\n",
    "        component_directory=RAW_S1_DIR,\n",
    "        component_name=\"S1Hand\",\n",
    "    )\n",
    "\n",
    "    resolved_source_records.append(\n",
    "        {\n",
    "            \"scene_id\": scene_id,\n",
    "            \"s2_source_path\": (\n",
    "                str(s2_source_path) if s2_source_path else \"\"\n",
    "            ),\n",
    "            \"s1_source_path\": (\n",
    "                str(s1_source_path) if s1_source_path else \"\"\n",
    "            ),\n",
    "            \"s2_source_exists\": bool(\n",
    "                s2_source_path and s2_source_path.exists()\n",
    "            ),\n",
    "            \"s1_source_exists\": bool(\n",
    "                s1_source_path and s1_source_path.exists()\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "source_resolution_df = pd.DataFrame(resolved_source_records)\n",
    "\n",
    "missing_s2 = source_resolution_df.loc[\n",
    "    ~source_resolution_df[\"s2_source_exists\"],\n",
    "    \"scene_id\",\n",
    "].tolist()\n",
    "\n",
    "missing_s1 = source_resolution_df.loc[\n",
    "    ~source_resolution_df[\"s1_source_exists\"],\n",
    "    \"scene_id\",\n",
    "].tolist()\n",
    "\n",
    "print(\"\\nSOURCE-RASTER RESOLUTION\")\n",
    "print(\"-\" * 80)\n",
    "print(\n",
    "    \"Sentinel-2 rasters resolved : \"\n",
    "    f\"{source_resolution_df['s2_source_exists'].sum():,}\"\n",
    ")\n",
    "print(\n",
    "    \"Sentinel-1 rasters resolved : \"\n",
    "    f\"{source_resolution_df['s1_source_exists'].sum():,}\"\n",
    ")\n",
    "print(f\"Missing Sentinel-2 scenes    : {missing_s2}\")\n",
    "print(f\"Missing Sentinel-1 scenes    : {missing_s1}\")\n",
    "\n",
    "if missing_s2 or missing_s1:\n",
    "    raise FileNotFoundError(\n",
    "        \"One or more required source rasters could not be resolved. \"\n",
    "        \"Review the missing scene lists above.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 4. IMAGE-PROCESSING UTILITIES\n",
    "# =============================================================================\n",
    "\n",
    "NODATA_SENTINEL_VALUES = [-9999, -32768]\n",
    "\n",
    "\n",
    "def md5_hash(file_path, chunk_size=1024 * 1024):\n",
    "    \"\"\"Calculate an MD5 checksum for a local file.\"\"\"\n",
    "\n",
    "    digest = hashlib.md5()\n",
    "\n",
    "    with open(file_path, \"rb\") as file:\n",
    "        while True:\n",
    "            chunk = file.read(chunk_size)\n",
    "\n",
    "            if not chunk:\n",
    "                break\n",
    "\n",
    "            digest.update(chunk)\n",
    "\n",
    "    return digest.hexdigest()\n",
    "\n",
    "\n",
    "def valid_pixel_mask(array, nodata_value=None):\n",
    "    \"\"\"Create a mask for finite, non-nodata raster values.\"\"\"\n",
    "\n",
    "    mask = np.isfinite(array)\n",
    "\n",
    "    if nodata_value is not None:\n",
    "        mask &= array != nodata_value\n",
    "\n",
    "    for sentinel_value in NODATA_SENTINEL_VALUES:\n",
    "        mask &= array != sentinel_value\n",
    "\n",
    "    return mask\n",
    "\n",
    "\n",
    "def percentile_stretch(\n",
    "    array,\n",
    "    lower_percentile=2.0,\n",
    "    upper_percentile=98.0,\n",
    "    nodata_value=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Convert a continuous raster band to an 8-bit visualization using a\n",
    "    percentile stretch.\n",
    "    \"\"\"\n",
    "\n",
    "    array = np.asarray(array, dtype=np.float32)\n",
    "    mask = valid_pixel_mask(array, nodata_value)\n",
    "\n",
    "    output = np.zeros(array.shape, dtype=np.uint8)\n",
    "\n",
    "    if not np.any(mask):\n",
    "        return output, np.nan, np.nan\n",
    "\n",
    "    valid_values = array[mask]\n",
    "\n",
    "    lower_value = float(\n",
    "        np.percentile(valid_values, lower_percentile)\n",
    "    )\n",
    "    upper_value = float(\n",
    "        np.percentile(valid_values, upper_percentile)\n",
    "    )\n",
    "\n",
    "    if not np.isfinite(lower_value):\n",
    "        lower_value = float(np.nanmin(valid_values))\n",
    "\n",
    "    if not np.isfinite(upper_value):\n",
    "        upper_value = float(np.nanmax(valid_values))\n",
    "\n",
    "    if upper_value <= lower_value:\n",
    "        upper_value = lower_value + 1.0\n",
    "\n",
    "    stretched = (\n",
    "        (array.astype(np.float32) - lower_value)\n",
    "        / (upper_value - lower_value)\n",
    "    )\n",
    "\n",
    "    stretched = np.clip(stretched, 0.0, 1.0)\n",
    "\n",
    "    output[mask] = np.round(\n",
    "        stretched[mask] * 255.0\n",
    "    ).astype(np.uint8)\n",
    "\n",
    "    return output, lower_value, upper_value\n",
    "\n",
    "\n",
    "def validate_png(png_path, expected_width=512, expected_height=512):\n",
    "    \"\"\"Validate that a PNG is readable and has three RGB channels.\"\"\"\n",
    "\n",
    "    result = {\n",
    "        \"png_exists\": False,\n",
    "        \"png_readable\": False,\n",
    "        \"png_mode\": \"\",\n",
    "        \"png_width\": 0,\n",
    "        \"png_height\": 0,\n",
    "        \"png_valid\": False,\n",
    "        \"png_error\": \"\",\n",
    "    }\n",
    "\n",
    "    try:\n",
    "        png_path = Path(png_path)\n",
    "\n",
    "        result[\"png_exists\"] = png_path.exists()\n",
    "\n",
    "        if not result[\"png_exists\"]:\n",
    "            result[\"png_error\"] = \"PNG file does not exist.\"\n",
    "            return result\n",
    "\n",
    "        with Image.open(png_path) as image:\n",
    "            image.load()\n",
    "\n",
    "            result[\"png_readable\"] = True\n",
    "            result[\"png_mode\"] = image.mode\n",
    "            result[\"png_width\"] = int(image.width)\n",
    "            result[\"png_height\"] = int(image.height)\n",
    "\n",
    "            result[\"png_valid\"] = bool(\n",
    "                image.mode == \"RGB\"\n",
    "                and image.width == expected_width\n",
    "                and image.height == expected_height\n",
    "            )\n",
    "\n",
    "        return result\n",
    "\n",
    "    except Exception as exc:\n",
    "        result[\"png_error\"] = str(exc)\n",
    "        return result\n",
    "\n",
    "\n",
    "def create_sentinel2_rgb(\n",
    "    source_path,\n",
    "    output_path,\n",
    "    lower_percentile=2.0,\n",
    "    upper_percentile=98.0,\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a true-color Sentinel-2 RGB PNG.\n",
    "\n",
    "    SEN1Floods11 S2Hand is expected to contain the standard 13 Sentinel-2\n",
    "    bands in spectral order:\n",
    "        1 B1\n",
    "        2 B2  Blue\n",
    "        3 B3  Green\n",
    "        4 B4  Red\n",
    "        5 B5\n",
    "        6 B6\n",
    "        7 B7\n",
    "        8 B8\n",
    "        9 B8A\n",
    "       10 B9\n",
    "       11 B10\n",
    "       12 B11\n",
    "       13 B12\n",
    "\n",
    "    RGB is therefore read as raster bands 4, 3, and 2.\n",
    "    \"\"\"\n",
    "\n",
    "    source_path = Path(source_path)\n",
    "    output_path = Path(output_path)\n",
    "    output_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    with rasterio.open(source_path) as src:\n",
    "        if src.count < 4:\n",
    "            raise ValueError(\n",
    "                f\"{source_path.name} has {src.count} band(s); \"\n",
    "                \"at least four are needed for B4-B3-B2.\"\n",
    "            )\n",
    "\n",
    "        nodata_value = src.nodata\n",
    "\n",
    "        red_raw = src.read(4)\n",
    "        green_raw = src.read(3)\n",
    "        blue_raw = src.read(2)\n",
    "\n",
    "        red, red_low, red_high = percentile_stretch(\n",
    "            red_raw,\n",
    "            lower_percentile,\n",
    "            upper_percentile,\n",
    "            nodata_value,\n",
    "        )\n",
    "\n",
    "        green, green_low, green_high = percentile_stretch(\n",
    "            green_raw,\n",
    "            lower_percentile,\n",
    "            upper_percentile,\n",
    "            nodata_value,\n",
    "        )\n",
    "\n",
    "        blue, blue_low, blue_high = percentile_stretch(\n",
    "            blue_raw,\n",
    "            lower_percentile,\n",
    "            upper_percentile,\n",
    "            nodata_value,\n",
    "        )\n",
    "\n",
    "        rgb = np.dstack([red, green, blue])\n",
    "\n",
    "        Image.fromarray(rgb, mode=\"RGB\").save(\n",
    "            output_path,\n",
    "            format=\"PNG\",\n",
    "            optimize=True,\n",
    "        )\n",
    "\n",
    "        metadata = {\n",
    "            \"source_width\": int(src.width),\n",
    "            \"source_height\": int(src.height),\n",
    "            \"source_band_count\": int(src.count),\n",
    "            \"source_dtype\": \",\".join(src.dtypes),\n",
    "            \"source_crs\": str(src.crs),\n",
    "            \"source_nodata\": (\n",
    "                None if src.nodata is None else float(src.nodata)\n",
    "            ),\n",
    "            \"red_source_band\": 4,\n",
    "            \"green_source_band\": 3,\n",
    "            \"blue_source_band\": 2,\n",
    "            \"red_stretch_low\": red_low,\n",
    "            \"red_stretch_high\": red_high,\n",
    "            \"green_stretch_low\": green_low,\n",
    "            \"green_stretch_high\": green_high,\n",
    "            \"blue_stretch_low\": blue_low,\n",
    "            \"blue_stretch_high\": blue_high,\n",
    "        }\n",
    "\n",
    "    return metadata\n",
    "\n",
    "\n",
    "def create_sentinel1_visualization(\n",
    "    source_path,\n",
    "    output_path,\n",
    "    lower_percentile=2.0,\n",
    "    upper_percentile=98.0,\n",
    "):\n",
    "    \"\"\"\n",
    "    Create a three-channel Sentinel-1 visualization.\n",
    "\n",
    "    Channel construction:\n",
    "        Red   = Band 1\n",
    "        Green = Band 2\n",
    "        Blue  = Band 1 - Band 2\n",
    "\n",
    "    The two source bands are retained separately in the raw GeoTIFF. The\n",
    "    derived third channel provides additional polarization contrast for the\n",
    "    pretrained RGB vision encoder.\n",
    "    \"\"\"\n",
    "\n",
    "    source_path = Path(source_path)\n",
    "    output_path = Path(output_path)\n",
    "    output_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    with rasterio.open(source_path) as src:\n",
    "        if src.count < 2:\n",
    "            raise ValueError(\n",
    "                f\"{source_path.name} has {src.count} band(s); \"\n",
    "                \"two Sentinel-1 bands are required.\"\n",
    "            )\n",
    "\n",
    "        nodata_value = src.nodata\n",
    "\n",
    "        band_1_raw = src.read(1).astype(np.float32)\n",
    "        band_2_raw = src.read(2).astype(np.float32)\n",
    "\n",
    "        contrast_raw = band_1_raw - band_2_raw\n",
    "\n",
    "        channel_red, red_low, red_high = percentile_stretch(\n",
    "            band_1_raw,\n",
    "            lower_percentile,\n",
    "            upper_percentile,\n",
    "            nodata_value,\n",
    "        )\n",
    "\n",
    "        channel_green, green_low, green_high = percentile_stretch(\n",
    "            band_2_raw,\n",
    "            lower_percentile,\n",
    "            upper_percentile,\n",
    "            nodata_value,\n",
    "        )\n",
    "\n",
    "        channel_blue, blue_low, blue_high = percentile_stretch(\n",
    "            contrast_raw,\n",
    "            lower_percentile,\n",
    "            upper_percentile,\n",
    "            nodata_value=None,\n",
    "        )\n",
    "\n",
    "        visualization = np.dstack(\n",
    "            [\n",
    "                channel_red,\n",
    "                channel_green,\n",
    "                channel_blue,\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        Image.fromarray(\n",
    "            visualization,\n",
    "            mode=\"RGB\",\n",
    "        ).save(\n",
    "            output_path,\n",
    "            format=\"PNG\",\n",
    "            optimize=True,\n",
    "        )\n",
    "\n",
    "        metadata = {\n",
    "            \"source_width\": int(src.width),\n",
    "            \"source_height\": int(src.height),\n",
    "            \"source_band_count\": int(src.count),\n",
    "            \"source_dtype\": \",\".join(src.dtypes),\n",
    "            \"source_crs\": str(src.crs),\n",
    "            \"source_nodata\": (\n",
    "                None if src.nodata is None else float(src.nodata)\n",
    "            ),\n",
    "            \"red_source\": \"S1_band_1\",\n",
    "            \"green_source\": \"S1_band_2\",\n",
    "            \"blue_source\": \"S1_band_1_minus_band_2\",\n",
    "            \"red_stretch_low\": red_low,\n",
    "            \"red_stretch_high\": red_high,\n",
    "            \"green_stretch_low\": green_low,\n",
    "            \"green_stretch_high\": green_high,\n",
    "            \"blue_stretch_low\": blue_low,\n",
    "            \"blue_stretch_high\": blue_high,\n",
    "        }\n",
    "\n",
    "    return metadata\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 5. GENERATE MODEL-READY IMAGES\n",
    "# =============================================================================\n",
    "\n",
    "image_generation_records = []\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"GENERATING MODEL-READY PNG IMAGES\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "for scene_number, row in enumerate(\n",
    "    source_resolution_df.itertuples(index=False),\n",
    "    start=1,\n",
    "):\n",
    "    scene_id = row.scene_id\n",
    "\n",
    "    s2_source_path = Path(row.s2_source_path)\n",
    "    s1_source_path = Path(row.s1_source_path)\n",
    "\n",
    "    s2_png_path = S2_RGB_DIR / f\"{scene_id}_S2_RGB.png\"\n",
    "    s1_png_path = S1_VIS_DIR / f\"{scene_id}_S1_VIS.png\"\n",
    "\n",
    "    print(f\"[{scene_number:02d}/25] {scene_id}\")\n",
    "\n",
    "    record = {\n",
    "        \"scene_id\": scene_id,\n",
    "        \"s2_source_path\": str(s2_source_path),\n",
    "        \"s1_source_path\": str(s1_source_path),\n",
    "        \"s2_png_path\": str(s2_png_path),\n",
    "        \"s1_png_path\": str(s1_png_path),\n",
    "        \"s2_generation_status\": \"NOT_STARTED\",\n",
    "        \"s1_generation_status\": \"NOT_STARTED\",\n",
    "        \"s2_error\": \"\",\n",
    "        \"s1_error\": \"\",\n",
    "    }\n",
    "\n",
    "    # -------------------------------------------------------------------------\n",
    "    # Sentinel-2 RGB\n",
    "    # -------------------------------------------------------------------------\n",
    "\n",
    "    try:\n",
    "        s2_metadata = create_sentinel2_rgb(\n",
    "            source_path=s2_source_path,\n",
    "            output_path=s2_png_path,\n",
    "        )\n",
    "\n",
    "        record.update(\n",
    "            {\n",
    "                f\"s2_{key}\": value\n",
    "                for key, value in s2_metadata.items()\n",
    "            }\n",
    "        )\n",
    "\n",
    "        record[\"s2_generation_status\"] = \"CREATED\"\n",
    "\n",
    "    except Exception as exc:\n",
    "        record[\"s2_generation_status\"] = \"FAILED\"\n",
    "        record[\"s2_error\"] = str(exc)\n",
    "\n",
    "    # -------------------------------------------------------------------------\n",
    "    # Sentinel-1 visualization\n",
    "    # -------------------------------------------------------------------------\n",
    "\n",
    "    try:\n",
    "        s1_metadata = create_sentinel1_visualization(\n",
    "            source_path=s1_source_path,\n",
    "            output_path=s1_png_path,\n",
    "        )\n",
    "\n",
    "        record.update(\n",
    "            {\n",
    "                f\"s1_{key}\": value\n",
    "                for key, value in s1_metadata.items()\n",
    "            }\n",
    "        )\n",
    "\n",
    "        record[\"s1_generation_status\"] = \"CREATED\"\n",
    "\n",
    "    except Exception as exc:\n",
    "        record[\"s1_generation_status\"] = \"FAILED\"\n",
    "        record[\"s1_error\"] = str(exc)\n",
    "\n",
    "    # -------------------------------------------------------------------------\n",
    "    # PNG validation\n",
    "    # -------------------------------------------------------------------------\n",
    "\n",
    "    s2_validation = validate_png(s2_png_path)\n",
    "    s1_validation = validate_png(s1_png_path)\n",
    "\n",
    "    record.update(\n",
    "        {\n",
    "            f\"s2_{key}\": value\n",
    "            for key, value in s2_validation.items()\n",
    "        }\n",
    "    )\n",
    "\n",
    "    record.update(\n",
    "        {\n",
    "            f\"s1_{key}\": value\n",
    "            for key, value in s1_validation.items()\n",
    "        }\n",
    "    )\n",
    "\n",
    "    if s2_png_path.exists():\n",
    "        record[\"s2_png_size_bytes\"] = s2_png_path.stat().st_size\n",
    "        record[\"s2_png_md5\"] = md5_hash(s2_png_path)\n",
    "    else:\n",
    "        record[\"s2_png_size_bytes\"] = 0\n",
    "        record[\"s2_png_md5\"] = \"\"\n",
    "\n",
    "    if s1_png_path.exists():\n",
    "        record[\"s1_png_size_bytes\"] = s1_png_path.stat().st_size\n",
    "        record[\"s1_png_md5\"] = md5_hash(s1_png_path)\n",
    "    else:\n",
    "        record[\"s1_png_size_bytes\"] = 0\n",
    "        record[\"s1_png_md5\"] = \"\"\n",
    "\n",
    "    record[\"scene_images_ready\"] = bool(\n",
    "        record.get(\"s2_png_valid\", False)\n",
    "        and record.get(\"s1_png_valid\", False)\n",
    "    )\n",
    "\n",
    "    image_generation_records.append(record)\n",
    "\n",
    "    print(\n",
    "        \"    \"\n",
    "        f\"S2 RGB: {record['s2_generation_status']} | \"\n",
    "        f\"Valid: {record.get('s2_png_valid', False)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"    \"\n",
    "        f\"S1 VIS: {record['s1_generation_status']} | \"\n",
    "        f\"Valid: {record.get('s1_png_valid', False)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "image_generation_df = pd.DataFrame(image_generation_records)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 6. ADD MODEL-READY PATHS TO THE SCENE MANIFEST\n",
    "# =============================================================================\n",
    "\n",
    "manifest_update_columns = image_generation_df[\n",
    "    [\n",
    "        \"scene_id\",\n",
    "        \"s2_png_path\",\n",
    "        \"s1_png_path\",\n",
    "        \"s2_png_md5\",\n",
    "        \"s1_png_md5\",\n",
    "        \"s2_png_valid\",\n",
    "        \"s1_png_valid\",\n",
    "        \"scene_images_ready\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "updated_scene_manifest_df = scene_manifest_df.drop(\n",
    "    columns=[\n",
    "        \"s2_png_path\",\n",
    "        \"s1_png_path\",\n",
    "        \"s2_png_md5\",\n",
    "        \"s1_png_md5\",\n",
    "        \"s2_png_valid\",\n",
    "        \"s1_png_valid\",\n",
    "        \"scene_images_ready\",\n",
    "    ],\n",
    "    errors=\"ignore\",\n",
    ").merge(\n",
    "    manifest_update_columns,\n",
    "    on=\"scene_id\",\n",
    "    how=\"left\",\n",
    "    validate=\"one_to_one\",\n",
    ")\n",
    "\n",
    "# Store project-relative paths for portable training manifests.\n",
    "updated_scene_manifest_df[\"s2_png_relative_path\"] = (\n",
    "    updated_scene_manifest_df[\"s2_png_path\"]\n",
    "    .apply(lambda value: Path(value).relative_to(PROJECT_ROOT).as_posix())\n",
    ")\n",
    "\n",
    "updated_scene_manifest_df[\"s1_png_relative_path\"] = (\n",
    "    updated_scene_manifest_df[\"s1_png_path\"]\n",
    "    .apply(lambda value: Path(value).relative_to(PROJECT_ROOT).as_posix())\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 7. VALIDATION\n",
    "# =============================================================================\n",
    "\n",
    "validation_checks = {\n",
    "    \"source_scene_count_is_positive\": (\n",
    "        len(source_resolution_df) == 25\n",
    "    ),\n",
    "    \"generation_record_count_is_25\": (\n",
    "        len(image_generation_df) == 25\n",
    "    ),\n",
    "    \"all_s2_sources_exist\": bool(\n",
    "        source_resolution_df[\"s2_source_exists\"].all()\n",
    "    ),\n",
    "    \"all_s1_sources_exist\": bool(\n",
    "        source_resolution_df[\"s1_source_exists\"].all()\n",
    "    ),\n",
    "    \"all_s2_pngs_created\": bool(\n",
    "        (\n",
    "            image_generation_df[\"s2_generation_status\"]\n",
    "            == \"CREATED\"\n",
    "        ).all()\n",
    "    ),\n",
    "    \"all_s1_pngs_created\": bool(\n",
    "        (\n",
    "            image_generation_df[\"s1_generation_status\"]\n",
    "            == \"CREATED\"\n",
    "        ).all()\n",
    "    ),\n",
    "    \"all_s2_pngs_valid\": bool(\n",
    "        image_generation_df[\"s2_png_valid\"].all()\n",
    "    ),\n",
    "    \"all_s1_pngs_valid\": bool(\n",
    "        image_generation_df[\"s1_png_valid\"].all()\n",
    "    ),\n",
    "    \"all_scenes_have_both_pngs\": bool(\n",
    "        image_generation_df[\"scene_images_ready\"].all()\n",
    "    ),\n",
    "    \"updated_manifest_has_25_scenes\": (\n",
    "        len(updated_scene_manifest_df) == 25\n",
    "    ),\n",
    "    \"updated_manifest_scene_ids_unique\": bool(\n",
    "        updated_scene_manifest_df[\"scene_id\"].is_unique\n",
    "    ),\n",
    "}\n",
    "\n",
    "validation_df = pd.DataFrame(\n",
    "    {\n",
    "        \"validation_check\": validation_checks.keys(),\n",
    "        \"passed\": validation_checks.values(),\n",
    "    }\n",
    ")\n",
    "\n",
    "component_summary_df = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"image_product\": \"Sentinel-2 true-color RGB\",\n",
    "            \"expected_images\": 25,\n",
    "            \"created_images\": int(\n",
    "                (\n",
    "                    image_generation_df[\"s2_generation_status\"]\n",
    "                    == \"CREATED\"\n",
    "                ).sum()\n",
    "            ),\n",
    "            \"valid_images\": int(\n",
    "                image_generation_df[\"s2_png_valid\"].sum()\n",
    "            ),\n",
    "            \"total_size_bytes\": int(\n",
    "                image_generation_df[\"s2_png_size_bytes\"].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"image_product\": \"Sentinel-1 polarization visualization\",\n",
    "            \"expected_images\": 25,\n",
    "            \"created_images\": int(\n",
    "                (\n",
    "                    image_generation_df[\"s1_generation_status\"]\n",
    "                    == \"CREATED\"\n",
    "                ).sum()\n",
    "            ),\n",
    "            \"valid_images\": int(\n",
    "                image_generation_df[\"s1_png_valid\"].sum()\n",
    "            ),\n",
    "            \"total_size_bytes\": int(\n",
    "                image_generation_df[\"s1_png_size_bytes\"].sum()\n",
    "            ),\n",
    "        },\n",
    "    ]\n",
    ")\n",
    "\n",
    "component_summary_df[\"total_size_mb\"] = (\n",
    "    component_summary_df[\"total_size_bytes\"]\n",
    "    / (1024 ** 2)\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 8. SAVE OUTPUTS\n",
    "# =============================================================================\n",
    "\n",
    "IMAGE_GENERATION_MANIFEST_PATH = (\n",
    "    MANIFEST_DIR / \"model_ready_image_manifest.csv\"\n",
    ")\n",
    "\n",
    "IMAGE_GENERATION_JSON_PATH = (\n",
    "    MANIFEST_DIR / \"model_ready_image_manifest.json\"\n",
    ")\n",
    "\n",
    "UPDATED_SCENE_MANIFEST_PATH = (\n",
    "    MASTER_DIR / \"scene_multimodal_manifest.csv\"\n",
    ")\n",
    "\n",
    "UPDATED_SCENE_MANIFEST_JSON_PATH = (\n",
    "    MASTER_DIR / \"scene_multimodal_manifest.json\"\n",
    ")\n",
    "\n",
    "VALIDATION_PATH = (\n",
    "    VALIDATION_DIR / \"model_ready_image_validation.csv\"\n",
    ")\n",
    "\n",
    "COMPONENT_SUMMARY_PATH = (\n",
    "    VALIDATION_DIR / \"model_ready_image_component_summary.csv\"\n",
    ")\n",
    "\n",
    "IMAGE_SUMMARY_PATH = (\n",
    "    MASTER_DIR / \"notebook_08_image_generation_summary.json\"\n",
    ")\n",
    "\n",
    "\n",
    "image_generation_df.to_csv(\n",
    "    IMAGE_GENERATION_MANIFEST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    IMAGE_GENERATION_JSON_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        image_generation_df.to_dict(orient=\"records\"),\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "updated_scene_manifest_df.to_csv(\n",
    "    UPDATED_SCENE_MANIFEST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    UPDATED_SCENE_MANIFEST_JSON_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        updated_scene_manifest_df.to_dict(orient=\"records\"),\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "validation_df.to_csv(\n",
    "    VALIDATION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "component_summary_df.to_csv(\n",
    "    COMPONENT_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "summary_payload = {\n",
    "    \"notebook\": \"08_build_vlm_dataset\",\n",
    "    \"stage\": \"model_ready_image_generation\",\n",
    "    \"dataset_version\": \"v1.0\",\n",
    "    \"scene_count\": int(len(image_generation_df)),\n",
    "    \"sentinel2_png_count\": int(\n",
    "        image_generation_df[\"s2_png_valid\"].sum()\n",
    "    ),\n",
    "    \"sentinel1_png_count\": int(\n",
    "        image_generation_df[\"s1_png_valid\"].sum()\n",
    "    ),\n",
    "    \"fully_ready_scene_count\": int(\n",
    "        image_generation_df[\"scene_images_ready\"].sum()\n",
    "    ),\n",
    "    \"sentinel2_processing\": {\n",
    "        \"source_component\": \"S2Hand\",\n",
    "        \"source_bands\": {\n",
    "            \"red\": 4,\n",
    "            \"green\": 3,\n",
    "            \"blue\": 2,\n",
    "        },\n",
    "        \"stretch\": \"independent 2nd–98th percentile\",\n",
    "        \"output_format\": \"RGB PNG\",\n",
    "    },\n",
    "    \"sentinel1_processing\": {\n",
    "        \"source_component\": \"S1Hand\",\n",
    "        \"output_channels\": {\n",
    "            \"red\": \"band_1\",\n",
    "            \"green\": \"band_2\",\n",
    "            \"blue\": \"band_1_minus_band_2\",\n",
    "        },\n",
    "        \"stretch\": \"independent 2nd–98th percentile\",\n",
    "        \"output_format\": \"RGB PNG\",\n",
    "    },\n",
    "    \"validation_results\": {\n",
    "        key: bool(value)\n",
    "        for key, value in validation_checks.items()\n",
    "    },\n",
    "    \"overall_status\": (\n",
    "        \"complete\"\n",
    "        if all(validation_checks.values())\n",
    "        else \"failed_validation\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "with open(\n",
    "    IMAGE_SUMMARY_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        summary_payload,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 9. FINAL REPORT AND INTEGRITY GATE\n",
    "# =============================================================================\n",
    "\n",
    "print(\"\\nMODEL-READY IMAGE VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for check_name, passed in validation_checks.items():\n",
    "    print(f\"{check_name:<40}: {passed}\")\n",
    "\n",
    "print(\"\\nIMAGE COMPONENT SUMMARY\")\n",
    "print(\"-\" * 80)\n",
    "print(component_summary_df.to_string(index=False))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"MODEL-READY IMAGE GENERATION COMPLETE\")\n",
    "print(\"=\" * 80)\n",
    "print(f\"Required scenes                  : {len(required_scenes):,}\")\n",
    "print(\n",
    "    \"Valid Sentinel-2 RGB images     : \"\n",
    "    f\"{image_generation_df['s2_png_valid'].sum():,}\"\n",
    ")\n",
    "print(\n",
    "    \"Valid Sentinel-1 visualizations : \"\n",
    "    f\"{image_generation_df['s1_png_valid'].sum():,}\"\n",
    ")\n",
    "print(\n",
    "    \"Scenes with both image products : \"\n",
    "    f\"{image_generation_df['scene_images_ready'].sum():,}\"\n",
    ")\n",
    "print(\n",
    "    \"Overall image-generation status : \"\n",
    "    f\"{summary_payload['overall_status']}\"\n",
    ")\n",
    "\n",
    "print(\"\\nOUTPUT FILES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for output_path in [\n",
    "    IMAGE_GENERATION_MANIFEST_PATH,\n",
    "    IMAGE_GENERATION_JSON_PATH,\n",
    "    UPDATED_SCENE_MANIFEST_PATH,\n",
    "    UPDATED_SCENE_MANIFEST_JSON_PATH,\n",
    "    VALIDATION_PATH,\n",
    "    COMPONENT_SUMMARY_PATH,\n",
    "    IMAGE_SUMMARY_PATH,\n",
    "]:\n",
    "    print(output_path)\n",
    "\n",
    "print(\"\\nMODEL-READY IMAGE PREVIEW\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "preview_columns = [\n",
    "    \"scene_id\",\n",
    "    \"s2_generation_status\",\n",
    "    \"s2_png_valid\",\n",
    "    \"s1_generation_status\",\n",
    "    \"s1_png_valid\",\n",
    "    \"scene_images_ready\",\n",
    "]\n",
    "\n",
    "print(\n",
    "    image_generation_df[\n",
    "        preview_columns\n",
    "    ].head(10).to_string(index=False)\n",
    ")\n",
    "\n",
    "if not all(validation_checks.values()):\n",
    "    failed_checks = [\n",
    "        key\n",
    "        for key, value in validation_checks.items()\n",
    "        if not value\n",
    "    ]\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Model-ready image generation failed one or more validation checks: \"\n",
    "        + \", \".join(failed_checks)\n",
    "    )\n",
    "\n",
    "print(\"\\nNEXT STEP\")\n",
    "print(\"-\" * 80)\n",
    "print(\n",
    "    \"Proceed to Notebook 08 Cell 3 to join the 150 grounded instructions \"\n",
    "    \"with the model-ready Sentinel-2 and Sentinel-1 PNG imagery.\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 80)"
   ]
  },
