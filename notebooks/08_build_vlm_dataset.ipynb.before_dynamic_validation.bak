   "source": [
    "# =============================================================================\n",
    "# NOTEBOOK 08 — CELL 3\n",
    "# BUILD TRAINING-READY MULTIMODAL VLM DATASETS\n",
    "# =============================================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "import shutil\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 1. PROJECT PATHS\n",
    "# =============================================================================\n",
    "\n",
    "PROJECT_ROOT = Path(\n",
    "    r\"C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\"\n",
    ")\n",
    "\n",
    "INSTRUCTION_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    "    / \"processed\"\n",
    "    / \"instruction_generation\"\n",
    "    / \"master\"\n",
    ")\n",
    "\n",
    "VLM_DATASET_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    "    / \"processed\"\n",
    "    / \"vlm_dataset\"\n",
    ")\n",
    "\n",
    "MASTER_DIR = VLM_DATASET_DIR / \"master\"\n",
    "MANIFEST_DIR = VLM_DATASET_DIR / \"manifests\"\n",
    "VALIDATION_DIR = VLM_DATASET_DIR / \"validation\"\n",
    "\n",
    "QWEN_DIR = VLM_DATASET_DIR / \"qwen\"\n",
    "LLAVA_DIR = VLM_DATASET_DIR / \"llava\"\n",
    "HUGGINGFACE_DIR = VLM_DATASET_DIR / \"huggingface\"\n",
    "\n",
    "TRAINING_IMAGE_DIR = VLM_DATASET_DIR / \"training_images\"\n",
    "TRAINING_S2_DIR = TRAINING_IMAGE_DIR / \"sentinel2_rgb\"\n",
    "TRAINING_S1_DIR = TRAINING_IMAGE_DIR / \"sentinel1_visualization\"\n",
    "\n",
    "INSTRUCTION_PATH = (\n",
    "    INSTRUCTION_DIR / \"master_grounded_instruction_records.csv\"\n",
    ")\n",
    "\n",
    "SCENE_MANIFEST_PATH = (\n",
    "    MASTER_DIR / \"scene_multimodal_manifest.csv\"\n",
    ")\n",
    "\n",
    "for directory in [\n",
    "    MASTER_DIR,\n",
    "    MANIFEST_DIR,\n",
    "    VALIDATION_DIR,\n",
    "    QWEN_DIR,\n",
    "    LLAVA_DIR,\n",
    "    HUGGINGFACE_DIR,\n",
    "    TRAINING_IMAGE_DIR,\n",
    "    TRAINING_S2_DIR,\n",
    "    TRAINING_S1_DIR,\n",
    "]:\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"NOTEBOOK 08: TRAINING-READY VLM DATASET CONSTRUCTION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\nINPUT FILES\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Instruction records : {INSTRUCTION_PATH}\")\n",
    "print(f\"Scene manifest      : {SCENE_MANIFEST_PATH}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 2. LOAD INPUTS\n",
    "# =============================================================================\n",
    "\n",
    "if not INSTRUCTION_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"Instruction dataset not found: {INSTRUCTION_PATH}\"\n",
    "    )\n",
    "\n",
    "if not SCENE_MANIFEST_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"Scene multimodal manifest not found: {SCENE_MANIFEST_PATH}\"\n",
    "    )\n",
    "\n",
    "instruction_df = pd.read_csv(\n",
    "    INSTRUCTION_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "scene_manifest_df = pd.read_csv(\n",
    "    SCENE_MANIFEST_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "print(\"\\nLOADED INPUTS\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Instruction records : {len(instruction_df):,}\")\n",
    "print(f\"Instruction scenes  : {instruction_df['scene_id'].nunique():,}\")\n",
    "print(f\"Manifest scenes     : {scene_manifest_df['scene_id'].nunique():,}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 3. DISCOVER INSTRUCTION AND RESPONSE COLUMNS\n",
    "# =============================================================================\n",
    "\n",
    "INSTRUCTION_COLUMN_CANDIDATES = [\n",
    "    \"instruction\",\n",
    "    \"instruction_text\",\n",
    "    \"prompt\",\n",
    "    \"user_prompt\",\n",
    "    \"question\",\n",
    "]\n",
    "\n",
    "RESPONSE_COLUMN_CANDIDATES = [\n",
    "    \"response\",\n",
    "    \"response_text\",\n",
    "    \"answer\",\n",
    "    \"assistant_response\",\n",
    "    \"grounded_response\",\n",
    "]\n",
    "\n",
    "TASK_FAMILY_COLUMN_CANDIDATES = [\n",
    "    \"task_family\",\n",
    "    \"instruction_type\",\n",
    "    \"task_type\",\n",
    "]\n",
    "\n",
    "RELIABILITY_COLUMN_CANDIDATES = [\n",
    "    \"grounding_reliability\",\n",
    "    \"reliability\",\n",
    "    \"evidence_reliability\",\n",
    "]\n",
    "\n",
    "FLOOD_BURDEN_COLUMN_CANDIDATES = [\n",
    "    \"scene_flood_burden\",\n",
    "    \"flood_burden\",\n",
    "]\n",
    "\n",
    "DISRUPTION_COLUMN_CANDIDATES = [\n",
    "    \"critical_network_disruption\",\n",
    "    \"disruption_level\",\n",
    "]\n",
    "\n",
    "\n",
    "def first_existing_column(dataframe, candidates, required=True):\n",
    "    \"\"\"Return the first matching column from a candidate list.\"\"\"\n",
    "\n",
    "    for column in candidates:\n",
    "        if column in dataframe.columns:\n",
    "            return column\n",
    "\n",
    "    if required:\n",
    "        raise ValueError(\n",
    "            \"None of the required candidate columns were found: \"\n",
    "            + \", \".join(candidates)\n",
    "        )\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "instruction_column = first_existing_column(\n",
    "    instruction_df,\n",
    "    INSTRUCTION_COLUMN_CANDIDATES,\n",
    ")\n",
    "\n",
    "response_column = first_existing_column(\n",
    "    instruction_df,\n",
    "    RESPONSE_COLUMN_CANDIDATES,\n",
    ")\n",
    "\n",
    "task_family_column = first_existing_column(\n",
    "    instruction_df,\n",
    "    TASK_FAMILY_COLUMN_CANDIDATES,\n",
    ")\n",
    "\n",
    "reliability_column = first_existing_column(\n",
    "    instruction_df,\n",
    "    RELIABILITY_COLUMN_CANDIDATES,\n",
    "    required=False,\n",
    ")\n",
    "\n",
    "flood_burden_column = first_existing_column(\n",
    "    instruction_df,\n",
    "    FLOOD_BURDEN_COLUMN_CANDIDATES,\n",
    "    required=False,\n",
    ")\n",
    "\n",
    "disruption_column = first_existing_column(\n",
    "    instruction_df,\n",
    "    DISRUPTION_COLUMN_CANDIDATES,\n",
    "    required=False,\n",
    ")\n",
    "\n",
    "print(\"\\nCOLUMN DISCOVERY\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Instruction column : {instruction_column}\")\n",
    "print(f\"Response column    : {response_column}\")\n",
    "print(f\"Task-family column : {task_family_column}\")\n",
    "print(f\"Reliability column : {reliability_column}\")\n",
    "print(f\"Flood burden       : {flood_burden_column}\")\n",
    "print(f\"Disruption column  : {disruption_column}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 4. VALIDATE REQUIRED MANIFEST FIELDS\n",
    "# =============================================================================\n",
    "\n",
    "required_manifest_columns = [\n",
    "    \"scene_id\",\n",
    "    \"s2_png_path\",\n",
    "    \"s1_png_path\",\n",
    "    \"s2_png_valid\",\n",
    "    \"s1_png_valid\",\n",
    "    \"scene_images_ready\",\n",
    "]\n",
    "\n",
    "missing_manifest_columns = [\n",
    "    column\n",
    "    for column in required_manifest_columns\n",
    "    if column not in scene_manifest_df.columns\n",
    "]\n",
    "\n",
    "if missing_manifest_columns:\n",
    "    raise ValueError(\n",
    "        \"Scene manifest is missing required columns: \"\n",
    "        + \", \".join(missing_manifest_columns)\n",
    "    )\n",
    "\n",
    "if scene_manifest_df[\"scene_id\"].duplicated().any():\n",
    "    raise ValueError(\n",
    "        \"Duplicate scene IDs were found in the scene manifest.\"\n",
    "    )\n",
    "\n",
    "scene_manifest_df[\"s2_png_valid\"] = (\n",
    "    scene_manifest_df[\"s2_png_valid\"]\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .map({\"true\": True, \"false\": False})\n",
    ")\n",
    "\n",
    "scene_manifest_df[\"s1_png_valid\"] = (\n",
    "    scene_manifest_df[\"s1_png_valid\"]\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .map({\"true\": True, \"false\": False})\n",
    ")\n",
    "\n",
    "scene_manifest_df[\"scene_images_ready\"] = (\n",
    "    scene_manifest_df[\"scene_images_ready\"]\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .map({\"true\": True, \"false\": False})\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 5. JOIN INSTRUCTIONS WITH MULTIMODAL IMAGES\n",
    "# =============================================================================\n",
    "\n",
    "manifest_join_columns = [\n",
    "    column\n",
    "    for column in [\n",
    "        \"scene_id\",\n",
    "        \"s2_png_path\",\n",
    "        \"s1_png_path\",\n",
    "        \"s2_png_relative_path\",\n",
    "        \"s1_png_relative_path\",\n",
    "        \"s2_png_md5\",\n",
    "        \"s1_png_md5\",\n",
    "        \"s2_png_valid\",\n",
    "        \"s1_png_valid\",\n",
    "        \"scene_images_ready\",\n",
    "        \"primary_image_component\",\n",
    "        \"scene_flood_burden\",\n",
    "        \"critical_network_disruption\",\n",
    "        \"grounding_reliability\",\n",
    "    ]\n",
    "    if column in scene_manifest_df.columns\n",
    "]\n",
    "\n",
    "vlm_master_df = instruction_df.merge(\n",
    "    scene_manifest_df[manifest_join_columns],\n",
    "    on=\"scene_id\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    "    suffixes=(\"\", \"_manifest\"),\n",
    ")\n",
    "\n",
    "print(\"\\nJOIN RESULTS\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Joined records : {len(vlm_master_df):,}\")\n",
    "print(f\"Joined scenes  : {vlm_master_df['scene_id'].nunique():,}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 6. NORMALIZE CORE DATASET FIELDS\n",
    "# =============================================================================\n",
    "\n",
    "if \"instruction_id\" not in vlm_master_df.columns:\n",
    "    vlm_master_df[\"instruction_id\"] = [\n",
    "        f\"roadflood_vlm_{index:04d}\"\n",
    "        for index in range(1, len(vlm_master_df) + 1)\n",
    "    ]\n",
    "\n",
    "vlm_master_df[\"instruction_id\"] = (\n",
    "    vlm_master_df[\"instruction_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "vlm_master_df[\"scene_id\"] = (\n",
    "    vlm_master_df[\"scene_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "vlm_master_df[\"instruction_text\"] = (\n",
    "    vlm_master_df[instruction_column]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "vlm_master_df[\"response_text\"] = (\n",
    "    vlm_master_df[response_column]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "vlm_master_df[\"task_family_normalized\"] = (\n",
    "    vlm_master_df[task_family_column]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "if reliability_column:\n",
    "    vlm_master_df[\"reliability_normalized\"] = (\n",
    "        vlm_master_df[reliability_column]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "    )\n",
    "elif \"grounding_reliability\" in vlm_master_df.columns:\n",
    "    vlm_master_df[\"reliability_normalized\"] = (\n",
    "        vlm_master_df[\"grounding_reliability\"]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "    )\n",
    "else:\n",
    "    vlm_master_df[\"reliability_normalized\"] = \"\"\n",
    "\n",
    "if flood_burden_column:\n",
    "    vlm_master_df[\"flood_burden_normalized\"] = (\n",
    "        vlm_master_df[flood_burden_column]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "    )\n",
    "elif \"scene_flood_burden\" in vlm_master_df.columns:\n",
    "    vlm_master_df[\"flood_burden_normalized\"] = (\n",
    "        vlm_master_df[\"scene_flood_burden\"]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "    )\n",
    "else:\n",
    "    vlm_master_df[\"flood_burden_normalized\"] = \"\"\n",
    "\n",
    "if disruption_column:\n",
    "    vlm_master_df[\"disruption_normalized\"] = (\n",
    "        vlm_master_df[disruption_column]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .replace(\n",
    "            {\n",
    "                \"\": \"None\",\n",
    "                \"nan\": \"None\",\n",
    "                \"NaN\": \"None\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "elif \"critical_network_disruption\" in vlm_master_df.columns:\n",
    "    vlm_master_df[\"disruption_normalized\"] = (\n",
    "        vlm_master_df[\"critical_network_disruption\"]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .replace(\n",
    "            {\n",
    "                \"\": \"None\",\n",
    "                \"nan\": \"None\",\n",
    "                \"NaN\": \"None\",\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "else:\n",
    "    vlm_master_df[\"disruption_normalized\"] = \"None\"\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 7. COPY MODEL-READY IMAGES INTO A PORTABLE TRAINING DIRECTORY\n",
    "# =============================================================================\n",
    "\n",
    "training_image_records = []\n",
    "\n",
    "unique_scene_images_df = (\n",
    "    vlm_master_df[\n",
    "        [\n",
    "            \"scene_id\",\n",
    "            \"s2_png_path\",\n",
    "            \"s1_png_path\",\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates(subset=[\"scene_id\"])\n",
    "    .sort_values(\"scene_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\"\\nPACKAGING TRAINING IMAGES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for row in unique_scene_images_df.itertuples(index=False):\n",
    "    scene_id = row.scene_id\n",
    "\n",
    "    source_s2 = Path(row.s2_png_path)\n",
    "    source_s1 = Path(row.s1_png_path)\n",
    "\n",
    "    destination_s2 = (\n",
    "        TRAINING_S2_DIR / f\"{scene_id}_S2_RGB.png\"\n",
    "    )\n",
    "\n",
    "    destination_s1 = (\n",
    "        TRAINING_S1_DIR / f\"{scene_id}_S1_VIS.png\"\n",
    "    )\n",
    "\n",
    "    if not source_s2.exists():\n",
    "        raise FileNotFoundError(\n",
    "            f\"Missing Sentinel-2 PNG: {source_s2}\"\n",
    "        )\n",
    "\n",
    "    if not source_s1.exists():\n",
    "        raise FileNotFoundError(\n",
    "            f\"Missing Sentinel-1 PNG: {source_s1}\"\n",
    "        )\n",
    "\n",
    "    shutil.copy2(source_s2, destination_s2)\n",
    "    shutil.copy2(source_s1, destination_s1)\n",
    "\n",
    "    training_image_records.append(\n",
    "        {\n",
    "            \"scene_id\": scene_id,\n",
    "            \"training_s2_path\": str(destination_s2),\n",
    "            \"training_s1_path\": str(destination_s1),\n",
    "            \"training_s2_relative_path\": (\n",
    "                destination_s2.relative_to(\n",
    "                    VLM_DATASET_DIR\n",
    "                ).as_posix()\n",
    "            ),\n",
    "            \"training_s1_relative_path\": (\n",
    "                destination_s1.relative_to(\n",
    "                    VLM_DATASET_DIR\n",
    "                ).as_posix()\n",
    "            ),\n",
    "            \"training_s2_exists\": destination_s2.exists(),\n",
    "            \"training_s1_exists\": destination_s1.exists(),\n",
    "        }\n",
    "    )\n",
    "\n",
    "training_image_df = pd.DataFrame(training_image_records)\n",
    "\n",
    "vlm_master_df = vlm_master_df.merge(\n",
    "    training_image_df,\n",
    "    on=\"scene_id\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 8. BUILD A MULTIMODAL USER PROMPT\n",
    "# =============================================================================\n",
    "\n",
    "IMAGE_CONTEXT_TEXT = (\n",
    "    \"The first image is a Sentinel-2 true-color optical image. \"\n",
    "    \"The second image is a Sentinel-1 radar polarization visualization. \"\n",
    "    \"Use both images together with the transportation-grounding information \"\n",
    "    \"implied by the question. Distinguish visible evidence from inferred \"\n",
    "    \"transportation impacts and account for the stated evidence reliability.\"\n",
    ")\n",
    "\n",
    "\n",
    "def build_user_prompt(row):\n",
    "    \"\"\"Create a consistent multimodal instruction prompt.\"\"\"\n",
    "\n",
    "    reliability = row[\"reliability_normalized\"]\n",
    "    flood_burden = row[\"flood_burden_normalized\"]\n",
    "    disruption = row[\"disruption_normalized\"]\n",
    "\n",
    "    metadata_lines = []\n",
    "\n",
    "    if flood_burden:\n",
    "        metadata_lines.append(\n",
    "            f\"Scene flood burden: {flood_burden}.\"\n",
    "        )\n",
    "\n",
    "    if disruption:\n",
    "        metadata_lines.append(\n",
    "            f\"Critical-network disruption: {disruption}.\"\n",
    "        )\n",
    "\n",
    "    if reliability:\n",
    "        metadata_lines.append(\n",
    "            f\"Grounding reliability: {reliability}.\"\n",
    "        )\n",
    "\n",
    "    metadata_text = \" \".join(metadata_lines)\n",
    "\n",
    "    return (\n",
    "        f\"{IMAGE_CONTEXT_TEXT}\\n\\n\"\n",
    "        f\"{metadata_text}\\n\\n\"\n",
    "        f\"Task: {row['instruction_text']}\"\n",
    "    ).strip()\n",
    "\n",
    "\n",
    "vlm_master_df[\"multimodal_prompt\"] = (\n",
    "    vlm_master_df.apply(\n",
    "        build_user_prompt,\n",
    "        axis=1,\n",
    "    )\n",
    ")\n",
    "\n",
    "vlm_master_df[\"training_ready\"] = (\n",
    "    vlm_master_df[\"training_s2_exists\"].fillna(False)\n",
    "    & vlm_master_df[\"training_s1_exists\"].fillna(False)\n",
    "    & vlm_master_df[\"scene_images_ready\"].fillna(False)\n",
    "    & vlm_master_df[\"instruction_text\"].ne(\"\")\n",
    "    & vlm_master_df[\"response_text\"].ne(\"\")\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 9. BUILD QWEN2.5-VL FORMAT\n",
    "# =============================================================================\n",
    "\n",
    "qwen_records = []\n",
    "\n",
    "for row in vlm_master_df.itertuples(index=False):\n",
    "    qwen_records.append(\n",
    "        {\n",
    "            \"id\": row.instruction_id,\n",
    "            \"scene_id\": row.scene_id,\n",
    "            \"task_family\": row.task_family_normalized,\n",
    "            \"messages\": [\n",
    "                {\n",
    "                    \"role\": \"user\",\n",
    "                    \"content\": [\n",
    "                        {\n",
    "                            \"type\": \"image\",\n",
    "                            \"image\": row.training_s2_relative_path,\n",
    "                        },\n",
    "                        {\n",
    "                            \"type\": \"image\",\n",
    "                            \"image\": row.training_s1_relative_path,\n",
    "                        },\n",
    "                        {\n",
    "                            \"type\": \"text\",\n",
    "                            \"text\": row.multimodal_prompt,\n",
    "                        },\n",
    "                    ],\n",
    "                },\n",
    "                {\n",
    "                    \"role\": \"assistant\",\n",
    "                    \"content\": [\n",
    "                        {\n",
    "                            \"type\": \"text\",\n",
    "                            \"text\": row.response_text,\n",
    "                        }\n",
    "                    ],\n",
    "                },\n",
    "            ],\n",
    "            \"metadata\": {\n",
    "                \"scene_flood_burden\": (\n",
    "                    row.flood_burden_normalized\n",
    "                ),\n",
    "                \"critical_network_disruption\": (\n",
    "                    row.disruption_normalized\n",
    "                ),\n",
    "                \"grounding_reliability\": (\n",
    "                    row.reliability_normalized\n",
    "                ),\n",
    "                \"source_dataset\": \"SEN1Floods11\",\n",
    "                \"dataset_version\": \"v1.0\",\n",
    "            },\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 10. BUILD LLAVA FORMAT\n",
    "# =============================================================================\n",
    "# Standard LLaVA commonly uses one image per record. For multimodal experiments,\n",
    "# both image paths are retained in the \"images\" list and clearly described in\n",
    "# the conversation prompt.\n",
    "\n",
    "llava_records = []\n",
    "\n",
    "for row in vlm_master_df.itertuples(index=False):\n",
    "    llava_records.append(\n",
    "        {\n",
    "            \"id\": row.instruction_id,\n",
    "            \"scene_id\": row.scene_id,\n",
    "            \"images\": [\n",
    "                row.training_s2_relative_path,\n",
    "                row.training_s1_relative_path,\n",
    "            ],\n",
    "            \"conversations\": [\n",
    "                {\n",
    "                    \"from\": \"human\",\n",
    "                    \"value\": (\n",
    "                        \"<image>\\n<image>\\n\"\n",
    "                        + row.multimodal_prompt\n",
    "                    ),\n",
    "                },\n",
    "                {\n",
    "                    \"from\": \"gpt\",\n",
    "                    \"value\": row.response_text,\n",
    "                },\n",
    "            ],\n",
    "            \"task_family\": row.task_family_normalized,\n",
    "            \"grounding_reliability\": (\n",
    "                row.reliability_normalized\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 11. BUILD HUGGING FACE JSONL FORMAT\n",
    "# =============================================================================\n",
    "\n",
    "huggingface_records = []\n",
    "\n",
    "for row in vlm_master_df.itertuples(index=False):\n",
    "    huggingface_records.append(\n",
    "        {\n",
    "            \"instruction_id\": row.instruction_id,\n",
    "            \"scene_id\": row.scene_id,\n",
    "            \"task_family\": row.task_family_normalized,\n",
    "            \"images\": [\n",
    "                row.training_s2_relative_path,\n",
    "                row.training_s1_relative_path,\n",
    "            ],\n",
    "            \"sentinel2_image\": row.training_s2_relative_path,\n",
    "            \"sentinel1_image\": row.training_s1_relative_path,\n",
    "            \"instruction\": row.instruction_text,\n",
    "            \"multimodal_prompt\": row.multimodal_prompt,\n",
    "            \"response\": row.response_text,\n",
    "            \"scene_flood_burden\": (\n",
    "                row.flood_burden_normalized\n",
    "            ),\n",
    "            \"critical_network_disruption\": (\n",
    "                row.disruption_normalized\n",
    "            ),\n",
    "            \"grounding_reliability\": (\n",
    "                row.reliability_normalized\n",
    "            ),\n",
    "            \"training_ready\": bool(row.training_ready),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 12. DATASET VALIDATION\n",
    "# =============================================================================\n",
    "\n",
    "instructions_per_scene = (\n",
    "    vlm_master_df.groupby(\"scene_id\")\n",
    "    .size()\n",
    ")\n",
    "\n",
    "validation_checks = {\n",
    "    \"master_record_count_is_150\": (\n",
    "        len(vlm_master_df) == 150\n",
    "    ),\n",
    "    \"master_scene_count_is_positive\": (\n",
    "        vlm_master_df[\"scene_id\"].nunique() == 25\n",
    "    ),\n",
    "    \"task_family_count_is_6\": (\n",
    "        vlm_master_df[\n",
    "            \"task_family_normalized\"\n",
    "        ].nunique() == 6\n",
    "    ),\n",
    "    \"instruction_ids_unique\": bool(\n",
    "        vlm_master_df[\"instruction_id\"].is_unique\n",
    "    ),\n",
    "    \"six_records_per_scene\": bool(\n",
    "        (instructions_per_scene == 6).all()\n",
    "    ),\n",
    "    \"all_instruction_text_present\": bool(\n",
    "        vlm_master_df[\"instruction_text\"].ne(\"\").all()\n",
    "    ),\n",
    "    \"all_response_text_present\": bool(\n",
    "        vlm_master_df[\"response_text\"].ne(\"\").all()\n",
    "    ),\n",
    "    \"all_s2_training_images_exist\": bool(\n",
    "        vlm_master_df[\"training_s2_exists\"].all()\n",
    "    ),\n",
    "    \"all_s1_training_images_exist\": bool(\n",
    "        vlm_master_df[\"training_s1_exists\"].all()\n",
    "    ),\n",
    "    \"all_records_training_ready\": bool(\n",
    "        vlm_master_df[\"training_ready\"].all()\n",
    "    ),\n",
    "    \"qwen_record_count_is_150\": (\n",
    "        len(qwen_records) == 150\n",
    "    ),\n",
    "    \"llava_record_count_is_150\": (\n",
    "        len(llava_records) == 150\n",
    "    ),\n",
    "    \"huggingface_record_count_is_150\": (\n",
    "        len(huggingface_records) == 150\n",
    "    ),\n",
    "}\n",
    "\n",
    "validation_df = pd.DataFrame(\n",
    "    {\n",
    "        \"validation_check\": validation_checks.keys(),\n",
    "        \"passed\": validation_checks.values(),\n",
    "    }\n",
    ")\n",
    "\n",
    "task_family_summary_df = (\n",
    "    vlm_master_df.groupby(\n",
    "        \"task_family_normalized\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        instruction_count=(\"instruction_id\", \"count\"),\n",
    "        scene_count=(\"scene_id\", \"nunique\"),\n",
    "        training_ready_count=(\"training_ready\", \"sum\"),\n",
    "    )\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"task_family_normalized\": \"task_family\",\n",
    "        }\n",
    "    )\n",
    ")\n",
    "\n",
    "scene_summary_df = (\n",
    "    vlm_master_df.groupby(\n",
    "        \"scene_id\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        instruction_count=(\"instruction_id\", \"count\"),\n",
    "        task_family_count=(\n",
    "            \"task_family_normalized\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "        all_records_ready=(\"training_ready\", \"all\"),\n",
    "        s2_image=(\"training_s2_relative_path\", \"first\"),\n",
    "        s1_image=(\"training_s1_relative_path\", \"first\"),\n",
    "        flood_burden=(\n",
    "            \"flood_burden_normalized\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        disruption_level=(\n",
    "            \"disruption_normalized\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        reliability=(\n",
    "            \"reliability_normalized\",\n",
    "            \"first\",\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 13. SAVE DATASET OUTPUTS\n",
    "# =============================================================================\n",
    "\n",
    "MASTER_CSV_PATH = (\n",
    "    MASTER_DIR / \"master_vlm_dataset.csv\"\n",
    ")\n",
    "\n",
    "MASTER_JSON_PATH = (\n",
    "    MASTER_DIR / \"master_vlm_dataset.json\"\n",
    ")\n",
    "\n",
    "MASTER_JSONL_PATH = (\n",
    "    MASTER_DIR / \"master_vlm_dataset.jsonl\"\n",
    ")\n",
    "\n",
    "QWEN_JSON_PATH = (\n",
    "    QWEN_DIR / \"qwen_multimodal_train.json\"\n",
    ")\n",
    "\n",
    "QWEN_JSONL_PATH = (\n",
    "    QWEN_DIR / \"qwen_multimodal_train.jsonl\"\n",
    ")\n",
    "\n",
    "LLAVA_JSON_PATH = (\n",
    "    LLAVA_DIR / \"llava_multimodal_train.json\"\n",
    ")\n",
    "\n",
    "HF_JSONL_PATH = (\n",
    "    HUGGINGFACE_DIR / \"roadflood_vlm_dataset.jsonl\"\n",
    ")\n",
    "\n",
    "TRAINING_IMAGE_MANIFEST_PATH = (\n",
    "    MANIFEST_DIR / \"training_image_manifest.csv\"\n",
    ")\n",
    "\n",
    "DATASET_VALIDATION_PATH = (\n",
    "    VALIDATION_DIR / \"training_dataset_validation.csv\"\n",
    ")\n",
    "\n",
    "TASK_FAMILY_SUMMARY_PATH = (\n",
    "    VALIDATION_DIR / \"training_task_family_summary.csv\"\n",
    ")\n",
    "\n",
    "SCENE_SUMMARY_PATH = (\n",
    "    VALIDATION_DIR / \"training_scene_summary.csv\"\n",
    ")\n",
    "\n",
    "DATASET_SUMMARY_PATH = (\n",
    "    MASTER_DIR / \"notebook_08_dataset_summary.json\"\n",
    ")\n",
    "\n",
    "\n",
    "vlm_master_df.to_csv(\n",
    "    MASTER_CSV_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    MASTER_JSON_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        vlm_master_df.to_dict(orient=\"records\"),\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    MASTER_JSONL_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    for record in vlm_master_df.to_dict(orient=\"records\"):\n",
    "        file.write(\n",
    "            json.dumps(\n",
    "                record,\n",
    "                ensure_ascii=False,\n",
    "                default=str,\n",
    "            )\n",
    "            + \"\\n\"\n",
    "        )\n",
    "\n",
    "with open(\n",
    "    QWEN_JSON_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        qwen_records,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    QWEN_JSONL_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    for record in qwen_records:\n",
    "        file.write(\n",
    "            json.dumps(\n",
    "                record,\n",
    "                ensure_ascii=False,\n",
    "            )\n",
    "            + \"\\n\"\n",
    "        )\n",
    "\n",
    "with open(\n",
    "    LLAVA_JSON_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        llava_records,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    HF_JSONL_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    for record in huggingface_records:\n",
    "        file.write(\n",
    "            json.dumps(\n",
    "                record,\n",
    "                ensure_ascii=False,\n",
    "            )\n",
    "            + \"\\n\"\n",
    "        )\n",
    "\n",
    "training_image_df.to_csv(\n",
    "    TRAINING_IMAGE_MANIFEST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "validation_df.to_csv(\n",
    "    DATASET_VALIDATION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "task_family_summary_df.to_csv(\n",
    "    TASK_FAMILY_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "scene_summary_df.to_csv(\n",
    "    SCENE_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "summary_payload = {\n",
    "    \"notebook\": \"08_build_vlm_dataset\",\n",
    "    \"stage\": \"training_ready_dataset_construction\",\n",
    "    \"dataset_name\": \"RoadFlood-VLM\",\n",
    "    \"dataset_version\": \"v1.0\",\n",
    "    \"source_grounding_version\": \"v1.1\",\n",
    "    \"instruction_count\": int(len(vlm_master_df)),\n",
    "    \"scene_count\": int(\n",
    "        vlm_master_df[\"scene_id\"].nunique()\n",
    "    ),\n",
    "    \"task_family_count\": int(\n",
    "        vlm_master_df[\n",
    "            \"task_family_normalized\"\n",
    "        ].nunique()\n",
    "    ),\n",
    "    \"sentinel2_training_image_count\": int(\n",
    "        training_image_df[\n",
    "            \"training_s2_exists\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"sentinel1_training_image_count\": int(\n",
    "        training_image_df[\n",
    "            \"training_s1_exists\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"training_ready_record_count\": int(\n",
    "        vlm_master_df[\"training_ready\"].sum()\n",
    "    ),\n",
    "    \"qwen_record_count\": int(len(qwen_records)),\n",
    "    \"llava_record_count\": int(len(llava_records)),\n",
    "    \"huggingface_record_count\": int(\n",
    "        len(huggingface_records)\n",
    "    ),\n",
    "    \"image_configuration\": {\n",
    "        \"primary_image\": \"Sentinel-2 true-color RGB\",\n",
    "        \"secondary_image\": (\n",
    "            \"Sentinel-1 polarization visualization\"\n",
    "        ),\n",
    "        \"images_per_record\": 2,\n",
    "    },\n",
    "    \"validation_results\": {\n",
    "        key: bool(value)\n",
    "        for key, value in validation_checks.items()\n",
    "    },\n",
    "    \"overall_status\": (\n",
    "        \"complete\"\n",
    "        if all(validation_checks.values())\n",
    "        else \"failed_validation\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "with open(\n",
    "    DATASET_SUMMARY_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        summary_payload,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 14. FINAL REPORT\n",
    "# =============================================================================\n",
    "\n",
    "print(\"\\nTRAINING DATASET VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for check_name, passed in validation_checks.items():\n",
    "    print(f\"{check_name:<42}: {passed}\")\n",
    "\n",
    "print(\"\\nTASK-FAMILY SUMMARY\")\n",
    "print(\"-\" * 80)\n",
    "print(task_family_summary_df.to_string(index=False))\n",
    "\n",
    "print(\"\\nSCENE SUMMARY PREVIEW\")\n",
    "print(\"-\" * 80)\n",
    "print(scene_summary_df.head(10).to_string(index=False))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"TRAINING-READY VLM DATASET COMPLETE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Master instruction records      : \"\n",
    "    f\"{len(vlm_master_df):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Unique scenes                   : \"\n",
    "    f\"{vlm_master_df['scene_id'].nunique():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Task families                   : \"\n",
    "    f\"{vlm_master_df['task_family_normalized'].nunique():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Records with two valid images   : \"\n",
    "    f\"{vlm_master_df['training_ready'].sum():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Qwen2.5-VL records              : \"\n",
    "    f\"{len(qwen_records):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"LLaVA records                   : \"\n",
    "    f\"{len(llava_records):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Hugging Face records            : \"\n",
    "    f\"{len(huggingface_records):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Overall dataset status          : \"\n",
    "    f\"{summary_payload['overall_status']}\"\n",
    ")\n",
    "\n",
    "print(\"\\nOUTPUT FILES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for output_path in [\n",
    "    MASTER_CSV_PATH,\n",
    "    MASTER_JSON_PATH,\n",
    "    MASTER_JSONL_PATH,\n",
    "    QWEN_JSON_PATH,\n",
    "    QWEN_JSONL_PATH,\n",
    "    LLAVA_JSON_PATH,\n",
    "    HF_JSONL_PATH,\n",
    "    TRAINING_IMAGE_MANIFEST_PATH,\n",
    "    DATASET_VALIDATION_PATH,\n",
    "    TASK_FAMILY_SUMMARY_PATH,\n",
    "    SCENE_SUMMARY_PATH,\n",
    "    DATASET_SUMMARY_PATH,\n",
    "]:\n",
    "    print(output_path)\n",
    "\n",
    "if not all(validation_checks.values()):\n",
    "    failed_checks = [\n",
    "        check\n",
    "        for check, passed in validation_checks.items()\n",
    "        if not passed\n",
    "    ]\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Training dataset construction failed validation: \"\n",
    "        + \", \".join(failed_checks)\n",
    "    )\n",
    "\n",
    "print(\"\\nNEXT STEP\")\n",
    "print(\"-\" * 80)\n",
    "print(\n",
    "    \"Proceed to Notebook 08 Cell 4 to create scene-grouped \"\n",
    "    \"training, validation, and test splits without scene leakage.\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 80)"
   ]
  },
