      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\manifests\\model_ready_image_manifest.json\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\master\\scene_multimodal_manifest.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\master\\scene_multimodal_manifest.json\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\validation\\model_ready_image_validation.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\validation\\model_ready_image_component_summary.csv\n",
