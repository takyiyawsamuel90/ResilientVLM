   "source": [
    "# ============================================================\n",
    "# NOTEBOOK 08 — CELL 1\n",
    "# VLM DATASET SETUP, SOURCE DISCOVERY, AND SCENE MANIFEST\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import json\n",
    "import re\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"NOTEBOOK 08: BUILD VLM DATASET\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 1. Project paths\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "PROJECT_ROOT = Path.cwd().resolve()\n",
    "\n",
    "if PROJECT_ROOT.name == \"notebooks\":\n",
    "    PROJECT_ROOT = PROJECT_ROOT.parent\n",
    "\n",
    "DATA_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    ")\n",
    "\n",
    "PROCESSED_DIR = (\n",
    "    DATA_DIR\n",
    "    / \"processed\"\n",
    ")\n",
    "\n",
    "INSTRUCTION_MASTER_DIR = (\n",
    "    PROCESSED_DIR\n",
    "    / \"instruction_generation\"\n",
    "    / \"master\"\n",
    ")\n",
    "\n",
    "VLM_DATASET_DIR = (\n",
    "    PROCESSED_DIR\n",
    "    / \"vlm_dataset\"\n",
    ")\n",
    "\n",
    "VLM_MASTER_DIR = (\n",
    "    VLM_DATASET_DIR\n",
    "    / \"master\"\n",
    ")\n",
    "\n",
    "VLM_MANIFEST_DIR = (\n",
    "    VLM_DATASET_DIR\n",
    "    / \"manifests\"\n",
    ")\n",
    "\n",
    "VLM_VALIDATION_DIR = (\n",
    "    VLM_DATASET_DIR\n",
    "    / \"validation\"\n",
    ")\n",
    "\n",
    "VLM_IMAGE_DIR = (\n",
    "    VLM_DATASET_DIR\n",
    "    / \"images\"\n",
    ")\n",
    "\n",
    "VLM_SPLIT_DIR = (\n",
    "    VLM_DATASET_DIR\n",
    "    / \"splits\"\n",
    ")\n",
    "\n",
    "VLM_FORMAT_DIR = (\n",
    "    VLM_DATASET_DIR\n",
    "    / \"formats\"\n",
    ")\n",
    "\n",
    "\n",
    "for output_directory in [\n",
    "    VLM_DATASET_DIR,\n",
    "    VLM_MASTER_DIR,\n",
    "    VLM_MANIFEST_DIR,\n",
    "    VLM_VALIDATION_DIR,\n",
    "    VLM_IMAGE_DIR,\n",
    "    VLM_SPLIT_DIR,\n",
    "    VLM_FORMAT_DIR,\n",
    "]:\n",
    "    output_directory.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 2. Input files\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "MASTER_INSTRUCTION_CSV = (\n",
    "    INSTRUCTION_MASTER_DIR\n",
    "    / \"master_grounded_instruction_records.csv\"\n",
    ")\n",
    "\n",
    "MASTER_INSTRUCTION_JSON = (\n",
    "    INSTRUCTION_MASTER_DIR\n",
    "    / \"master_grounded_instruction_records.json\"\n",
    ")\n",
    "\n",
    "MASTER_CHAT_JSON = (\n",
    "    INSTRUCTION_MASTER_DIR\n",
    "    / \"master_grounded_instruction_chat.json\"\n",
    ")\n",
    "\n",
    "MASTER_CHAT_JSONL = (\n",
    "    INSTRUCTION_MASTER_DIR\n",
    "    / \"master_grounded_instruction_chat.jsonl\"\n",
    ")\n",
    "\n",
    "INSTRUCTION_SUMMARY_JSON = (\n",
    "    INSTRUCTION_MASTER_DIR\n",
    "    / \"instruction_generation_summary.json\"\n",
    ")\n",
    "\n",
    "\n",
    "INPUT_FILES = {\n",
    "    \"master_instruction_csv\": (\n",
    "        MASTER_INSTRUCTION_CSV\n",
    "    ),\n",
    "    \"master_instruction_json\": (\n",
    "        MASTER_INSTRUCTION_JSON\n",
    "    ),\n",
    "    \"master_chat_json\": (\n",
    "        MASTER_CHAT_JSON\n",
    "    ),\n",
    "    \"master_chat_jsonl\": (\n",
    "        MASTER_CHAT_JSONL\n",
    "    ),\n",
    "    \"instruction_summary\": (\n",
    "        INSTRUCTION_SUMMARY_JSON\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "print(\"\\nDIRECTORIES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Project root         : {PROJECT_ROOT}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Instruction input    : {INSTRUCTION_MASTER_DIR}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Notebook 08 output   : {VLM_DATASET_DIR}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nINPUT FILE VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for input_name, input_path in (\n",
    "    INPUT_FILES.items()\n",
    "):\n",
    "    print(\n",
    "        f\"{input_name:<24}: \"\n",
    "        f\"{input_path.exists()} | \"\n",
    "        f\"{input_path}\"\n",
    "    )\n",
    "\n",
    "\n",
    "missing_input_files = [\n",
    "    str(\n",
    "        input_path\n",
    "    )\n",
    "    for input_path in (\n",
    "        INPUT_FILES.values()\n",
    "    )\n",
    "    if not input_path.exists()\n",
    "]\n",
    "\n",
    "if missing_input_files:\n",
    "    raise FileNotFoundError(\n",
    "        \"Required Notebook 07 outputs are missing:\\n\"\n",
    "        + \"\\n\".join(\n",
    "            missing_input_files\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 3. Load Notebook 07 outputs\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "instruction_df = pd.read_csv(\n",
    "    MASTER_INSTRUCTION_CSV,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    MASTER_INSTRUCTION_JSON,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    instruction_records_json = (\n",
    "        json.load(\n",
    "            file\n",
    "        )\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    MASTER_CHAT_JSON,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    chat_records_json = (\n",
    "        json.load(\n",
    "            file\n",
    "        )\n",
    "    )\n",
    "\n",
    "with open(\n",
    "    INSTRUCTION_SUMMARY_JSON,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    instruction_generation_summary = (\n",
    "        json.load(\n",
    "            file\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"\\nLOADED NOTEBOOK 07 OUTPUTS\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Instruction records : \"\n",
    "    f\"{len(instruction_df):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Unique scenes       : \"\n",
    "    f\"{instruction_df['scene_id'].nunique():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Task families       : \"\n",
    "    f\"{instruction_df['task_family'].nunique():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Dataset version     : \"\n",
    "    f\"{instruction_generation_summary.get('instruction_dataset_version')}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Source grounding    : \"\n",
    "    f\"{instruction_generation_summary.get('source_grounding_version')}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Notebook 07 status  : \"\n",
    "    f\"{instruction_generation_summary.get('status')}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 4. Instruction dataset validation\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "REQUIRED_INSTRUCTION_COLUMNS = [\n",
    "    \"instruction_id\",\n",
    "    \"scene_id\",\n",
    "    \"task_family\",\n",
    "    \"instruction\",\n",
    "    \"input\",\n",
    "    \"response\",\n",
    "    \"scene_flood_burden\",\n",
    "    \"critical_network_disruption\",\n",
    "    \"grounding_reliability\",\n",
    "    \"transportation_flood_disruption_score\",\n",
    "    \"transportation_flood_disruption_rank\",\n",
    "    \"combined_transportation_flood_token\",\n",
    "    \"source_grounding_version\",\n",
    "    \"instruction_dataset_version\",\n",
    "]\n",
    "\n",
    "\n",
    "missing_instruction_columns = [\n",
    "    column_name\n",
    "    for column_name in (\n",
    "        REQUIRED_INSTRUCTION_COLUMNS\n",
    "    )\n",
    "    if column_name not in (\n",
    "        instruction_df.columns\n",
    "    )\n",
    "]\n",
    "\n",
    "\n",
    "print(\"\\nINSTRUCTION COLUMN VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Required columns : \"\n",
    "    f\"{len(REQUIRED_INSTRUCTION_COLUMNS)}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Missing columns  : \"\n",
    "    f\"{len(missing_instruction_columns)}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Missing names    : \"\n",
    "    f\"{missing_instruction_columns}\"\n",
    ")\n",
    "\n",
    "\n",
    "if missing_instruction_columns:\n",
    "    raise ValueError(\n",
    "        \"Notebook 07 instruction records are missing \"\n",
    "        f\"required columns: {missing_instruction_columns}\"\n",
    "    )\n",
    "\n",
    "\n",
    "instruction_df[\n",
    "    \"scene_id\"\n",
    "] = (\n",
    "    instruction_df[\n",
    "        \"scene_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "instruction_df[\n",
    "    \"instruction_id\"\n",
    "] = (\n",
    "    instruction_df[\n",
    "        \"instruction_id\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "instruction_df[\n",
    "    \"task_family\"\n",
    "] = (\n",
    "    instruction_df[\n",
    "        \"task_family\"\n",
    "    ]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "\n",
    "instruction_validation = {\n",
    "    \"instruction_count_matches_scene_count\": (\n",
    "        len(\n",
    "            instruction_df\n",
    "        )\n",
    "        == 150\n",
    "    ),\n",
    "    \"scene_count_is_positive\": (\n",
    "        instruction_df[\n",
    "            \"scene_id\"\n",
    "        ].nunique()\n",
    "        == 25\n",
    "    ),\n",
    "    \"task_family_count_is_6\": (\n",
    "        instruction_df[\n",
    "            \"task_family\"\n",
    "        ].nunique()\n",
    "        == 6\n",
    "    ),\n",
    "    \"instruction_ids_unique\": (\n",
    "        instruction_df[\n",
    "            \"instruction_id\"\n",
    "        ].duplicated().sum()\n",
    "        == 0\n",
    "    ),\n",
    "    \"six_instructions_per_scene\": (\n",
    "        instruction_df\n",
    "        .groupby(\n",
    "            \"scene_id\"\n",
    "        )\n",
    "        .size()\n",
    "        .eq(\n",
    "            6\n",
    "        )\n",
    "        .all()\n",
    "    ),\n",
    "    \"no_missing_instruction_text\": (\n",
    "        instruction_df[\n",
    "            \"instruction\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .ne(\"\")\n",
    "        .all()\n",
    "    ),\n",
    "    \"no_missing_response_text\": (\n",
    "        instruction_df[\n",
    "            \"response\"\n",
    "        ]\n",
    "        .astype(str)\n",
    "        .str.strip()\n",
    "        .ne(\"\")\n",
    "        .all()\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "print(\"\\nINSTRUCTION DATASET VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for check_name, check_result in (\n",
    "    instruction_validation.items()\n",
    "):\n",
    "    print(\n",
    "        f\"{check_name:<36}: \"\n",
    "        f\"{bool(check_result)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "if not all(\n",
    "    bool(\n",
    "        check_result\n",
    "    )\n",
    "    for check_result in (\n",
    "        instruction_validation.values()\n",
    "    )\n",
    "):\n",
    "    failed_checks = [\n",
    "        check_name\n",
    "        for check_name, check_result in (\n",
    "            instruction_validation.items()\n",
    "        )\n",
    "        if not bool(\n",
    "            check_result\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    raise ValueError(\n",
    "        \"Notebook 07 dataset validation failed: \"\n",
    "        f\"{failed_checks}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 5. Scene IDs required by the VLM dataset\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "required_scene_ids = sorted(\n",
    "    instruction_df[\n",
    "        \"scene_id\"\n",
    "    ]\n",
    "    .unique()\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "required_scene_id_set = set(\n",
    "    required_scene_ids\n",
    ")\n",
    "\n",
    "\n",
    "scene_instruction_summary_df = (\n",
    "    instruction_df\n",
    "    .groupby(\n",
    "        \"scene_id\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        instruction_count=(\n",
    "            \"instruction_id\",\n",
    "            \"count\",\n",
    "        ),\n",
    "        task_family_count=(\n",
    "            \"task_family\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "        scene_flood_burden=(\n",
    "            \"scene_flood_burden\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        critical_network_disruption=(\n",
    "            \"critical_network_disruption\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        grounding_reliability=(\n",
    "            \"grounding_reliability\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        disruption_score=(\n",
    "            \"transportation_flood_disruption_score\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        disruption_rank=(\n",
    "            \"transportation_flood_disruption_rank\",\n",
    "            \"first\",\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nSCENES REQUIRED FOR VLM PACKAGING\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Required scenes : \"\n",
    "    f\"{len(required_scene_ids):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    required_scene_ids\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 6. Raster discovery configuration\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "RASTER_EXTENSIONS = {\n",
    "    \".tif\",\n",
    "    \".tiff\",\n",
    "    \".png\",\n",
    "    \".jpg\",\n",
    "    \".jpeg\",\n",
    "}\n",
    "\n",
    "\n",
    "EXCLUDED_DISCOVERY_DIRECTORIES = {\n",
    "    \".git\",\n",
    "    \".venv\",\n",
    "    \"venv\",\n",
    "    \"__pycache__\",\n",
    "    \"node_modules\",\n",
    "    \"vlm_dataset\",\n",
    "}\n",
    "\n",
    "\n",
    "def path_is_excluded(\n",
    "    file_path,\n",
    "):\n",
    "    \"\"\"\n",
    "    Return True when a file is inside a directory that should\n",
    "    not be searched for original scene rasters.\n",
    "    \"\"\"\n",
    "\n",
    "    lowered_parts = {\n",
    "        part.lower()\n",
    "        for part in (\n",
    "            file_path.parts\n",
    "        )\n",
    "    }\n",
    "\n",
    "    return any(\n",
    "        excluded_name.lower()\n",
    "        in lowered_parts\n",
    "        for excluded_name in (\n",
    "            EXCLUDED_DISCOVERY_DIRECTORIES\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "def detect_scene_id(\n",
    "    file_path,\n",
    "    known_scene_ids,\n",
    "):\n",
    "    \"\"\"\n",
    "    Identify the scene ID represented by a raster path.\n",
    "\n",
    "    Checks the filename, stem, parent directories, and full path.\n",
    "    Longest scene IDs are checked first to avoid partial matches.\n",
    "    \"\"\"\n",
    "\n",
    "    searchable_text = (\n",
    "        str(\n",
    "            file_path\n",
    "        )\n",
    "        .replace(\n",
    "            \"\\\\\",\n",
    "            \"/\",\n",
    "        )\n",
    "        .lower()\n",
    "    )\n",
    "\n",
    "    file_stem = (\n",
    "        file_path.stem.lower()\n",
    "    )\n",
    "\n",
    "    path_parts = [\n",
    "        str(\n",
    "            part\n",
    "        ).lower()\n",
    "        for part in (\n",
    "            file_path.parts\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    for scene_id in sorted(\n",
    "        known_scene_ids,\n",
    "        key=len,\n",
    "        reverse=True,\n",
    "    ):\n",
    "        scene_id_lower = (\n",
    "            scene_id.lower()\n",
    "        )\n",
    "\n",
    "        if scene_id_lower == file_stem:\n",
    "            return scene_id\n",
    "\n",
    "        if scene_id_lower in path_parts:\n",
    "            return scene_id\n",
    "\n",
    "        if scene_id_lower in searchable_text:\n",
    "            return scene_id\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def classify_raster_component(\n",
    "    file_path,\n",
    "):\n",
    "    \"\"\"\n",
    "    Classify a raster into a SEN1Floods11 component using the\n",
    "    filename and directory structure.\n",
    "    \"\"\"\n",
    "\n",
    "    searchable_text = (\n",
    "        str(\n",
    "            file_path\n",
    "        )\n",
    "        .replace(\n",
    "            \"\\\\\",\n",
    "            \"/\",\n",
    "        )\n",
    "        .lower()\n",
    "    )\n",
    "\n",
    "    compact_text = re.sub(\n",
    "        r\"[^a-z0-9]+\",\n",
    "        \"\",\n",
    "        searchable_text,\n",
    "    )\n",
    "\n",
    "    if (\n",
    "        \"s2hand\" in compact_text\n",
    "        or \"sentinel2hand\" in compact_text\n",
    "    ):\n",
    "        return \"S2Hand\"\n",
    "\n",
    "    if (\n",
    "        \"s1otsulabelhand\" in compact_text\n",
    "        or \"s1otsu\" in compact_text\n",
    "    ):\n",
    "        return \"S1OtsuLabelHand\"\n",
    "\n",
    "    if (\n",
    "        \"jrchand\" in compact_text\n",
    "        or \"jrcwaterhand\" in compact_text\n",
    "        or \"jrcwater\" in compact_text\n",
    "    ):\n",
    "        return \"JRCWaterHand\"\n",
    "\n",
    "    if (\n",
    "        \"labelhand\" in compact_text\n",
    "        or \"floodlabel\" in compact_text\n",
    "    ):\n",
    "        return \"LabelHand\"\n",
    "\n",
    "    if (\n",
    "        \"s1hand\" in compact_text\n",
    "        or \"sentinel1hand\" in compact_text\n",
    "    ):\n",
    "        return \"S1Hand\"\n",
    "\n",
    "    if (\n",
    "        \"s2weak\" in compact_text\n",
    "        or \"sentinel2weak\" in compact_text\n",
    "    ):\n",
    "        return \"S2Weak\"\n",
    "\n",
    "    if (\n",
    "        \"s1weak\" in compact_text\n",
    "        or \"sentinel1weak\" in compact_text\n",
    "    ):\n",
    "        return \"S1Weak\"\n",
    "\n",
    "    if \"label\" in compact_text:\n",
    "        return \"OtherLabel\"\n",
    "\n",
    "    if (\n",
    "        \"sentinel2\" in compact_text\n",
    "        or re.search(\n",
    "            r\"(^|[^a-z0-9])s2([^a-z0-9]|$)\",\n",
    "            searchable_text,\n",
    "        )\n",
    "    ):\n",
    "        return \"OtherS2\"\n",
    "\n",
    "    if (\n",
    "        \"sentinel1\" in compact_text\n",
    "        or re.search(\n",
    "            r\"(^|[^a-z0-9])s1([^a-z0-9]|$)\",\n",
    "            searchable_text,\n",
    "        )\n",
    "    ):\n",
    "        return \"OtherS1\"\n",
    "\n",
    "    return \"UnclassifiedRaster\"\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 7. Discover all raster files in the project\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "print(\"\\nRASTER DISCOVERY\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "print(\n",
    "    \"Searching the project directory recursively. \"\n",
    "    \"This may take a moment.\"\n",
    ")\n",
    "\n",
    "\n",
    "discovered_raster_records = []\n",
    "\n",
    "for file_path in (\n",
    "    PROJECT_ROOT.rglob(\n",
    "        \"*\"\n",
    "    )\n",
    "):\n",
    "    if not file_path.is_file():\n",
    "        continue\n",
    "\n",
    "    if (\n",
    "        file_path.suffix.lower()\n",
    "        not in RASTER_EXTENSIONS\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "    if path_is_excluded(\n",
    "        file_path\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "    scene_id = detect_scene_id(\n",
    "        file_path,\n",
    "        required_scene_ids,\n",
    "    )\n",
    "\n",
    "    if scene_id is None:\n",
    "        continue\n",
    "\n",
    "    raster_component = (\n",
    "        classify_raster_component(\n",
    "            file_path\n",
    "        )\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        file_size_bytes = (\n",
    "            file_path.stat().st_size\n",
    "        )\n",
    "\n",
    "    except OSError:\n",
    "        file_size_bytes = None\n",
    "\n",
    "    discovered_raster_records.append(\n",
    "        {\n",
    "            \"scene_id\": (\n",
    "                scene_id\n",
    "            ),\n",
    "            \"raster_component\": (\n",
    "                raster_component\n",
    "            ),\n",
    "            \"file_name\": (\n",
    "                file_path.name\n",
    "            ),\n",
    "            \"file_extension\": (\n",
    "                file_path.suffix.lower()\n",
    "            ),\n",
    "            \"file_size_bytes\": (\n",
    "                file_size_bytes\n",
    "            ),\n",
    "            \"file_path\": str(\n",
    "                file_path.resolve()\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "raster_inventory_df = pd.DataFrame(\n",
    "    discovered_raster_records\n",
    ")\n",
    "\n",
    "\n",
    "if raster_inventory_df.empty:\n",
    "    raise FileNotFoundError(\n",
    "        \"No raster files matching the 25 Notebook 07 \"\n",
    "        \"scene IDs were found under the project directory.\"\n",
    "    )\n",
    "\n",
    "\n",
    "raster_inventory_df = (\n",
    "    raster_inventory_df\n",
    "    .drop_duplicates(\n",
    "        subset=[\n",
    "            \"scene_id\",\n",
    "            \"raster_component\",\n",
    "            \"file_path\",\n",
    "        ]\n",
    "    )\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"scene_id\",\n",
    "            \"raster_component\",\n",
    "            \"file_path\",\n",
    "        ]\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    f\"Matching raster files found : \"\n",
    "    f\"{len(raster_inventory_df):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Scenes with raster files     : \"\n",
    "    f\"{raster_inventory_df['scene_id'].nunique():,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 8. Raster-component inventory\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "raster_component_counts_df = (\n",
    "    raster_inventory_df\n",
    "    .groupby(\n",
    "        \"raster_component\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        raster_file_count=(\n",
    "            \"file_path\",\n",
    "            \"count\",\n",
    "        ),\n",
    "        scene_count=(\n",
    "            \"scene_id\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "    )\n",
    "    .sort_values(\n",
    "        [\n",
    "            \"scene_count\",\n",
    "            \"raster_file_count\",\n",
    "        ],\n",
    "        ascending=False,\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nRASTER COMPONENT COUNTS\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "display(\n",
    "    raster_component_counts_df\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 9. Preferred component selection\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "COMPONENT_PRIORITY = {\n",
    "    \"S2Hand\": 1,\n",
    "    \"OtherS2\": 2,\n",
    "    \"S2Weak\": 3,\n",
    "    \"S1Hand\": 4,\n",
    "    \"OtherS1\": 5,\n",
    "    \"S1Weak\": 6,\n",
    "    \"LabelHand\": 7,\n",
    "    \"S1OtsuLabelHand\": 8,\n",
    "    \"JRCWaterHand\": 9,\n",
    "    \"OtherLabel\": 10,\n",
    "    \"UnclassifiedRaster\": 99,\n",
    "}\n",
    "\n",
    "\n",
    "raster_inventory_df[\n",
    "    \"component_priority\"\n",
    "] = (\n",
    "    raster_inventory_df[\n",
    "        \"raster_component\"\n",
    "    ]\n",
    "    .map(\n",
    "        COMPONENT_PRIORITY\n",
    "    )\n",
    "    .fillna(\n",
    "        99\n",
    "    )\n",
    "    .astype(int)\n",
    ")\n",
    "\n",
    "\n",
    "def choose_preferred_component_path(\n",
    "    scene_group_df,\n",
    "    component_names,\n",
    "):\n",
    "    \"\"\"\n",
    "    Return the preferred path for the requested component classes.\n",
    "    \"\"\"\n",
    "\n",
    "    matching_df = (\n",
    "        scene_group_df[\n",
    "            scene_group_df[\n",
    "                \"raster_component\"\n",
    "            ].isin(\n",
    "                component_names\n",
    "            )\n",
    "        ]\n",
    "        .sort_values(\n",
    "            [\n",
    "                \"component_priority\",\n",
    "                \"file_size_bytes\",\n",
    "                \"file_path\",\n",
    "            ],\n",
    "            ascending=[\n",
    "                True,\n",
    "                False,\n",
    "                True,\n",
    "            ],\n",
    "            na_position=\"last\",\n",
    "        )\n",
    "    )\n",
    "\n",
    "    if matching_df.empty:\n",
    "        return \"\"\n",
    "\n",
    "    return str(\n",
    "        matching_df.iloc[\n",
    "            0\n",
    "        ][\n",
    "            \"file_path\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "\n",
    "scene_raster_manifest_records = []\n",
    "\n",
    "for scene_id, scene_group_df in (\n",
    "    raster_inventory_df.groupby(\n",
    "        \"scene_id\"\n",
    "    )\n",
    "):\n",
    "    s2_path = (\n",
    "        choose_preferred_component_path(\n",
    "            scene_group_df,\n",
    "            [\n",
    "                \"S2Hand\",\n",
    "                \"OtherS2\",\n",
    "                \"S2Weak\",\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "    s1_path = (\n",
    "        choose_preferred_component_path(\n",
    "            scene_group_df,\n",
    "            [\n",
    "                \"S1Hand\",\n",
    "                \"OtherS1\",\n",
    "                \"S1Weak\",\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "    flood_label_path = (\n",
    "        choose_preferred_component_path(\n",
    "            scene_group_df,\n",
    "            [\n",
    "                \"LabelHand\",\n",
    "                \"OtherLabel\",\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "    s1_otsu_label_path = (\n",
    "        choose_preferred_component_path(\n",
    "            scene_group_df,\n",
    "            [\n",
    "                \"S1OtsuLabelHand\",\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "    jrc_water_path = (\n",
    "        choose_preferred_component_path(\n",
    "            scene_group_df,\n",
    "            [\n",
    "                \"JRCWaterHand\",\n",
    "            ],\n",
    "        )\n",
    "    )\n",
    "\n",
    "    primary_image_path = (\n",
    "        s2_path\n",
    "        if s2_path\n",
    "        else s1_path\n",
    "    )\n",
    "\n",
    "    primary_image_component = \"\"\n",
    "\n",
    "    if primary_image_path:\n",
    "        selected_component_rows = (\n",
    "            scene_group_df[\n",
    "                scene_group_df[\n",
    "                    \"file_path\"\n",
    "                ]\n",
    "                == primary_image_path\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        if not selected_component_rows.empty:\n",
    "            primary_image_component = str(\n",
    "                selected_component_rows.iloc[\n",
    "                    0\n",
    "                ][\n",
    "                    \"raster_component\"\n",
    "                ]\n",
    "            )\n",
    "\n",
    "    scene_raster_manifest_records.append(\n",
    "        {\n",
    "            \"scene_id\": (\n",
    "                scene_id\n",
    "            ),\n",
    "            \"primary_image_path\": (\n",
    "                primary_image_path\n",
    "            ),\n",
    "            \"primary_image_component\": (\n",
    "                primary_image_component\n",
    "            ),\n",
    "            \"s2_path\": (\n",
    "                s2_path\n",
    "            ),\n",
    "            \"s1_path\": (\n",
    "                s1_path\n",
    "            ),\n",
    "            \"flood_label_path\": (\n",
    "                flood_label_path\n",
    "            ),\n",
    "            \"s1_otsu_label_path\": (\n",
    "                s1_otsu_label_path\n",
    "            ),\n",
    "            \"jrc_water_path\": (\n",
    "                jrc_water_path\n",
    "            ),\n",
    "            \"discovered_raster_count\": int(\n",
    "                len(\n",
    "                    scene_group_df\n",
    "                )\n",
    "            ),\n",
    "            \"has_primary_image\": bool(\n",
    "                primary_image_path\n",
    "            ),\n",
    "            \"has_s2_image\": bool(\n",
    "                s2_path\n",
    "            ),\n",
    "            \"has_s1_image\": bool(\n",
    "                s1_path\n",
    "            ),\n",
    "            \"has_flood_label\": bool(\n",
    "                flood_label_path\n",
    "            ),\n",
    "            \"has_s1_otsu_label\": bool(\n",
    "                s1_otsu_label_path\n",
    "            ),\n",
    "            \"has_jrc_water\": bool(\n",
    "                jrc_water_path\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "scene_raster_manifest_df = pd.DataFrame(\n",
    "    scene_raster_manifest_records\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 10. Add scenes for which no raster was discovered\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "manifest_scene_ids = set(\n",
    "    scene_raster_manifest_df[\n",
    "        \"scene_id\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "missing_raster_scene_ids = sorted(\n",
    "    required_scene_id_set\n",
    "    - manifest_scene_ids\n",
    ")\n",
    "\n",
    "\n",
    "if missing_raster_scene_ids:\n",
    "    missing_scene_records = []\n",
    "\n",
    "    for missing_scene_id in (\n",
    "        missing_raster_scene_ids\n",
    "    ):\n",
    "        missing_scene_records.append(\n",
    "            {\n",
    "                \"scene_id\": (\n",
    "                    missing_scene_id\n",
    "                ),\n",
    "                \"primary_image_path\": \"\",\n",
    "                \"primary_image_component\": \"\",\n",
    "                \"s2_path\": \"\",\n",
    "                \"s1_path\": \"\",\n",
    "                \"flood_label_path\": \"\",\n",
    "                \"s1_otsu_label_path\": \"\",\n",
    "                \"jrc_water_path\": \"\",\n",
    "                \"discovered_raster_count\": 0,\n",
    "                \"has_primary_image\": False,\n",
    "                \"has_s2_image\": False,\n",
    "                \"has_s1_image\": False,\n",
    "                \"has_flood_label\": False,\n",
    "                \"has_s1_otsu_label\": False,\n",
    "                \"has_jrc_water\": False,\n",
    "            }\n",
    "        )\n",
    "\n",
    "    scene_raster_manifest_df = pd.concat(\n",
    "        [\n",
    "            scene_raster_manifest_df,\n",
    "            pd.DataFrame(\n",
    "                missing_scene_records\n",
    "            ),\n",
    "        ],\n",
    "        ignore_index=True,\n",
    "    )\n",
    "\n",
    "\n",
    "scene_raster_manifest_df = (\n",
    "    scene_raster_manifest_df\n",
    "    .sort_values(\n",
    "        \"scene_id\"\n",
    "    )\n",
    "    .reset_index(\n",
    "        drop=True\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 11. Create complete multimodal scene manifest\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "scene_multimodal_manifest_df = (\n",
    "    scene_instruction_summary_df\n",
    "    .merge(\n",
    "        scene_raster_manifest_df,\n",
    "        on=\"scene_id\",\n",
    "        how=\"left\",\n",
    "        validate=\"one_to_one\",\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "boolean_manifest_columns = [\n",
    "    \"has_primary_image\",\n",
    "    \"has_s2_image\",\n",
    "    \"has_s1_image\",\n",
    "    \"has_flood_label\",\n",
    "    \"has_s1_otsu_label\",\n",
    "    \"has_jrc_water\",\n",
    "]\n",
    "\n",
    "\n",
    "for column_name in (\n",
    "    boolean_manifest_columns\n",
    "):\n",
    "    scene_multimodal_manifest_df[\n",
    "        column_name\n",
    "    ] = (\n",
    "        scene_multimodal_manifest_df[\n",
    "            column_name\n",
    "        ]\n",
    "        .fillna(\n",
    "            False\n",
    "        )\n",
    "        .astype(bool)\n",
    "    )\n",
    "\n",
    "\n",
    "scene_multimodal_manifest_df[\n",
    "    \"vlm_source_ready\"\n",
    "] = (\n",
    "    scene_multimodal_manifest_df[\n",
    "        \"has_primary_image\"\n",
    "    ]\n",
    "    & scene_multimodal_manifest_df[\n",
    "        \"instruction_count\"\n",
    "    ].eq(\n",
    "        6\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 12. Manifest validation\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "manifest_validation = {\n",
    "    \"manifest_has_25_scenes\": (\n",
    "        len(\n",
    "            scene_multimodal_manifest_df\n",
    "        )\n",
    "        == 25\n",
    "    ),\n",
    "    \"scene_ids_unique\": (\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"scene_id\"\n",
    "        ].duplicated().sum()\n",
    "        == 0\n",
    "    ),\n",
    "    \"all_instruction_scenes_present\": (\n",
    "        set(\n",
    "            scene_multimodal_manifest_df[\n",
    "                \"scene_id\"\n",
    "            ]\n",
    "        )\n",
    "        == required_scene_id_set\n",
    "    ),\n",
    "    \"all_scenes_have_six_instructions\": (\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"instruction_count\"\n",
    "        ]\n",
    "        .eq(\n",
    "            6\n",
    "        )\n",
    "        .all()\n",
    "    ),\n",
    "    \"all_scenes_have_primary_image\": (\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"has_primary_image\"\n",
    "        ]\n",
    "        .all()\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "print(\"\\nMULTIMODAL SCENE MANIFEST VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for check_name, check_result in (\n",
    "    manifest_validation.items()\n",
    "):\n",
    "    print(\n",
    "        f\"{check_name:<38}: \"\n",
    "        f\"{bool(check_result)}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 13. Coverage summary\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "coverage_summary_df = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"Primary image\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"has_primary_image\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"Sentinel-2 image\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"has_s2_image\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"Sentinel-1 image\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"has_s1_image\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"Flood label\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"has_flood_label\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"S1 Otsu label\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"has_s1_otsu_label\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"JRC water mask\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"has_jrc_water\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "        {\n",
    "            \"source_type\": (\n",
    "                \"VLM source ready\"\n",
    "            ),\n",
    "            \"scene_count\": int(\n",
    "                scene_multimodal_manifest_df[\n",
    "                    \"vlm_source_ready\"\n",
    "                ].sum()\n",
    "            ),\n",
    "        },\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "coverage_summary_df[\n",
    "    \"scene_share\"\n",
    "] = (\n",
    "    coverage_summary_df[\n",
    "        \"scene_count\"\n",
    "    ]\n",
    "    / len(\n",
    "        scene_multimodal_manifest_df\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nSOURCE COVERAGE SUMMARY\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "display(\n",
    "    coverage_summary_df\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 14. Save Notebook 08 setup outputs\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "RASTER_INVENTORY_CSV = (\n",
    "    VLM_MANIFEST_DIR\n",
    "    / \"raster_file_inventory.csv\"\n",
    ")\n",
    "\n",
    "SCENE_RASTER_MANIFEST_CSV = (\n",
    "    VLM_MANIFEST_DIR\n",
    "    / \"scene_raster_manifest.csv\"\n",
    ")\n",
    "\n",
    "SCENE_MULTIMODAL_MANIFEST_CSV = (\n",
    "    VLM_MASTER_DIR\n",
    "    / \"scene_multimodal_manifest.csv\"\n",
    ")\n",
    "\n",
    "SCENE_MULTIMODAL_MANIFEST_JSON = (\n",
    "    VLM_MASTER_DIR\n",
    "    / \"scene_multimodal_manifest.json\"\n",
    ")\n",
    "\n",
    "RASTER_COMPONENT_COUNTS_CSV = (\n",
    "    VLM_VALIDATION_DIR\n",
    "    / \"raster_component_counts.csv\"\n",
    ")\n",
    "\n",
    "SOURCE_COVERAGE_SUMMARY_CSV = (\n",
    "    VLM_VALIDATION_DIR\n",
    "    / \"source_coverage_summary.csv\"\n",
    ")\n",
    "\n",
    "MANIFEST_VALIDATION_CSV = (\n",
    "    VLM_VALIDATION_DIR\n",
    "    / \"scene_manifest_validation.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "raster_inventory_df.to_csv(\n",
    "    RASTER_INVENTORY_CSV,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "scene_raster_manifest_df.to_csv(\n",
    "    SCENE_RASTER_MANIFEST_CSV,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "scene_multimodal_manifest_df.to_csv(\n",
    "    SCENE_MULTIMODAL_MANIFEST_CSV,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    SCENE_MULTIMODAL_MANIFEST_JSON,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        scene_multimodal_manifest_df.to_dict(\n",
    "            orient=\"records\"\n",
    "        ),\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "raster_component_counts_df.to_csv(\n",
    "    RASTER_COMPONENT_COUNTS_CSV,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "coverage_summary_df.to_csv(\n",
    "    SOURCE_COVERAGE_SUMMARY_CSV,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "manifest_validation_df = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"validation_check\": (\n",
    "                check_name\n",
    "            ),\n",
    "            \"passed\": bool(\n",
    "                check_result\n",
    "            ),\n",
    "        }\n",
    "        for check_name, check_result in (\n",
    "            manifest_validation.items()\n",
    "        )\n",
    "    ]\n",
    ")\n",
    "\n",
    "manifest_validation_df.to_csv(\n",
    "    MANIFEST_VALIDATION_CSV,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 15. Notebook 08 metadata\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "VLM_DATASET_VERSION = \"v1.0\"\n",
    "\n",
    "VLM_BUILD_GENERATED_UTC = (\n",
    "    datetime.now(\n",
    "        timezone.utc\n",
    "    )\n",
    "    .replace(\n",
    "        microsecond=0\n",
    "    )\n",
    "    .isoformat()\n",
    ")\n",
    "\n",
    "\n",
    "notebook_08_setup_metadata = {\n",
    "    \"notebook\": (\n",
    "        \"08_build_vlm_dataset\"\n",
    "    ),\n",
    "    \"status\": (\n",
    "        \"source_manifest_created\"\n",
    "    ),\n",
    "    \"vlm_dataset_version\": (\n",
    "        VLM_DATASET_VERSION\n",
    "    ),\n",
    "    \"instruction_dataset_version\": (\n",
    "        instruction_generation_summary.get(\n",
    "            \"instruction_dataset_version\"\n",
    "        )\n",
    "    ),\n",
    "    \"source_grounding_version\": (\n",
    "        instruction_generation_summary.get(\n",
    "            \"source_grounding_version\"\n",
    "        )\n",
    "    ),\n",
    "    \"generated_utc\": (\n",
    "        VLM_BUILD_GENERATED_UTC\n",
    "    ),\n",
    "    \"instruction_record_count\": int(\n",
    "        len(\n",
    "            instruction_df\n",
    "        )\n",
    "    ),\n",
    "    \"scene_count\": int(\n",
    "        len(\n",
    "            scene_multimodal_manifest_df\n",
    "        )\n",
    "    ),\n",
    "    \"raster_file_count\": int(\n",
    "        len(\n",
    "            raster_inventory_df\n",
    "        )\n",
    "    ),\n",
    "    \"scene_with_primary_image_count\": int(\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"has_primary_image\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"scene_with_s2_count\": int(\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"has_s2_image\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"scene_with_s1_count\": int(\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"has_s1_image\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"scene_with_flood_label_count\": int(\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"has_flood_label\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"vlm_source_ready_scene_count\": int(\n",
    "        scene_multimodal_manifest_df[\n",
    "            \"vlm_source_ready\"\n",
    "        ].sum()\n",
    "    ),\n",
    "    \"manifest_validation\": {\n",
    "        key: bool(\n",
    "            value\n",
    "        )\n",
    "        for key, value in (\n",
    "            manifest_validation.items()\n",
    "        )\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "NOTEBOOK_08_SETUP_METADATA_JSON = (\n",
    "    VLM_MASTER_DIR\n",
    "    / \"notebook_08_setup_metadata.json\"\n",
    ")\n",
    "\n",
    "with open(\n",
    "    NOTEBOOK_08_SETUP_METADATA_JSON,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        notebook_08_setup_metadata,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 16. Final setup report\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ready_scene_count = int(\n",
    "    scene_multimodal_manifest_df[\n",
    "        \"vlm_source_ready\"\n",
    "    ].sum()\n",
    ")\n",
    "\n",
    "missing_primary_image_df = (\n",
    "    scene_multimodal_manifest_df[\n",
    "        ~scene_multimodal_manifest_df[\n",
    "            \"has_primary_image\"\n",
    "        ]\n",
    "    ][\n",
    "        [\n",
    "            \"scene_id\",\n",
    "            \"instruction_count\",\n",
    "            \"scene_flood_burden\",\n",
    "            \"critical_network_disruption\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"NOTEBOOK 08 SOURCE-MANIFEST SETUP COMPLETE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\n",
    "    f\"Instruction records loaded : \"\n",
    "    f\"{len(instruction_df):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Scenes required            : \"\n",
    "    f\"{len(required_scene_ids):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Matching raster files      : \"\n",
    "    f\"{len(raster_inventory_df):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Scenes with primary image  : \"\n",
    "    f\"{scene_multimodal_manifest_df['has_primary_image'].sum():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Scenes with Sentinel-2     : \"\n",
    "    f\"{scene_multimodal_manifest_df['has_s2_image'].sum():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Scenes with Sentinel-1     : \"\n",
    "    f\"{scene_multimodal_manifest_df['has_s1_image'].sum():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Scenes with flood labels   : \"\n",
    "    f\"{scene_multimodal_manifest_df['has_flood_label'].sum():,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"VLM source-ready scenes    : \"\n",
    "    f\"{ready_scene_count:,}\"\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\nOUTPUT FILES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for output_path in [\n",
    "    RASTER_INVENTORY_CSV,\n",
    "    SCENE_RASTER_MANIFEST_CSV,\n",
    "    SCENE_MULTIMODAL_MANIFEST_CSV,\n",
    "    SCENE_MULTIMODAL_MANIFEST_JSON,\n",
    "    RASTER_COMPONENT_COUNTS_CSV,\n",
    "    SOURCE_COVERAGE_SUMMARY_CSV,\n",
    "    MANIFEST_VALIDATION_CSV,\n",
    "    NOTEBOOK_08_SETUP_METADATA_JSON,\n",
    "]:\n",
    "    print(\n",
    "        output_path\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"\\nMULTIMODAL MANIFEST PREVIEW\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "display(\n",
    "    scene_multimodal_manifest_df[\n",
    "        [\n",
    "            \"scene_id\",\n",
    "            \"instruction_count\",\n",
    "            \"scene_flood_burden\",\n",
    "            \"critical_network_disruption\",\n",
    "            \"grounding_reliability\",\n",
    "            \"primary_image_component\",\n",
    "            \"has_s2_image\",\n",
    "            \"has_s1_image\",\n",
    "            \"has_flood_label\",\n",
    "            \"has_jrc_water\",\n",
    "            \"vlm_source_ready\",\n",
    "        ]\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "if not missing_primary_image_df.empty:\n",
    "    print(\"\\nSCENES MISSING A PRIMARY IMAGE\")\n",
    "    print(\"-\" * 80)\n",
    "\n",
    "    display(\n",
    "        missing_primary_image_df\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"\\nThe notebook has not failed because the manifest \"\n",
    "        \"was still generated. We will resolve these scene paths \"\n",
    "        \"before creating the final VLM records.\"\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"=\" * 80)"
   ]
  },
