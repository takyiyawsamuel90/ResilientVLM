      "Training records       : 102\n",
      "Validation records     : 24\n",
      "Test records           : 24\n",
      "Scene leakage          : False\n",
      "Overall notebook status: complete\n",
      "\n",
      "NEXT STEP\n",
      "--------------------------------------------------------------------------------\n",
      "Notebook 08 is complete. Proceed to 09_vlm_baselines.ipynb to evaluate zero-shot and prompt-based multimodal baselines before fine-tuning.\n",
      "================================================================================\n"
     ]
    }
   ],
   "source": [
    "# =============================================================================\n",
    "# NOTEBOOK 08 — CELL 5\n",
    "# FINAL DATASET INTEGRITY, DATASET CARD, AND NOTEBOOK COMPLETION\n",
    "# =============================================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "import hashlib\n",
    "import json\n",
    "\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 1. PATHS\n",
    "# =============================================================================\n",
    "\n",
    "PROJECT_ROOT = Path(\n",
    "    r\"C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\"\n",
    ")\n",
    "\n",
    "VLM_DATASET_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    "    / \"processed\"\n",
    "    / \"vlm_dataset\"\n",
    ")\n",
    "\n",
    "MASTER_DIR = VLM_DATASET_DIR / \"master\"\n",
    "SPLIT_DIR = VLM_DATASET_DIR / \"splits\"\n",
    "QWEN_SPLIT_DIR = SPLIT_DIR / \"qwen\"\n",
    "HF_SPLIT_DIR = SPLIT_DIR / \"huggingface\"\n",
    "VALIDATION_DIR = VLM_DATASET_DIR / \"validation\"\n",
    "DOCUMENTATION_DIR = VLM_DATASET_DIR / \"documentation\"\n",
    "\n",
    "MASTER_SPLIT_PATH = (\n",
    "    MASTER_DIR / \"master_vlm_dataset_with_splits.csv\"\n",
    ")\n",
    "\n",
    "SCENE_SPLIT_MANIFEST_PATH = (\n",
    "    SPLIT_DIR / \"scene_split_manifest.csv\"\n",
    ")\n",
    "\n",
    "TRAIN_PATH = SPLIT_DIR / \"train.csv\"\n",
    "VALIDATION_PATH = SPLIT_DIR / \"validation.csv\"\n",
    "TEST_PATH = SPLIT_DIR / \"test.csv\"\n",
    "\n",
    "NOTEBOOK_08_DATASET_SUMMARY_PATH = (\n",
    "    MASTER_DIR / \"notebook_08_dataset_summary.json\"\n",
    ")\n",
    "\n",
    "NOTEBOOK_08_SPLIT_SUMMARY_PATH = (\n",
    "    MASTER_DIR / \"notebook_08_split_summary.json\"\n",
    ")\n",
    "\n",
    "for directory in [\n",
    "    MASTER_DIR,\n",
    "    VALIDATION_DIR,\n",
    "    DOCUMENTATION_DIR,\n",
    "]:\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"NOTEBOOK 08: FINAL DATASET INTEGRITY AND COMPLETION\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 2. INPUT VALIDATION\n",
    "# =============================================================================\n",
    "\n",
    "required_input_paths = {\n",
    "    \"master_split_dataset\": MASTER_SPLIT_PATH,\n",
    "    \"scene_split_manifest\": SCENE_SPLIT_MANIFEST_PATH,\n",
    "    \"train_split\": TRAIN_PATH,\n",
    "    \"validation_split\": VALIDATION_PATH,\n",
    "    \"test_split\": TEST_PATH,\n",
    "    \"dataset_summary\": NOTEBOOK_08_DATASET_SUMMARY_PATH,\n",
    "    \"split_summary\": NOTEBOOK_08_SPLIT_SUMMARY_PATH,\n",
    "}\n",
    "\n",
    "print(\"\\nINPUT FILE VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "missing_input_files = []\n",
    "\n",
    "for file_name, file_path in required_input_paths.items():\n",
    "    exists = file_path.exists()\n",
    "\n",
    "    print(\n",
    "        f\"{file_name:<25}: \"\n",
    "        f\"{exists} | {file_path}\"\n",
    "    )\n",
    "\n",
    "    if not exists:\n",
    "        missing_input_files.append(str(file_path))\n",
    "\n",
    "if missing_input_files:\n",
    "    raise FileNotFoundError(\n",
    "        \"Notebook 08 finalization is missing required input files:\\n\"\n",
    "        + \"\\n\".join(missing_input_files)\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 3. LOAD DATASETS\n",
    "# =============================================================================\n",
    "\n",
    "master_df = pd.read_csv(\n",
    "    MASTER_SPLIT_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "scene_split_df = pd.read_csv(\n",
    "    SCENE_SPLIT_MANIFEST_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "train_df = pd.read_csv(\n",
    "    TRAIN_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "validation_df = pd.read_csv(\n",
    "    VALIDATION_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "test_df = pd.read_csv(\n",
    "    TEST_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    NOTEBOOK_08_DATASET_SUMMARY_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    dataset_summary = json.load(file)\n",
    "\n",
    "with open(\n",
    "    NOTEBOOK_08_SPLIT_SUMMARY_PATH,\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    split_summary = json.load(file)\n",
    "\n",
    "\n",
    "print(\"\\nLOADED DATASETS\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Master records     : {len(master_df):,}\")\n",
    "print(f\"Master scenes      : {master_df['scene_id'].nunique():,}\")\n",
    "print(f\"Training records   : {len(train_df):,}\")\n",
    "print(f\"Validation records : {len(validation_df):,}\")\n",
    "print(f\"Test records       : {len(test_df):,}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 4. NORMALIZE BOOLEAN FIELDS\n",
    "# =============================================================================\n",
    "\n",
    "BOOLEAN_COLUMNS = [\n",
    "    \"training_ready\",\n",
    "    \"training_s2_exists\",\n",
    "    \"training_s1_exists\",\n",
    "    \"scene_images_ready\",\n",
    "    \"s2_png_valid\",\n",
    "    \"s1_png_valid\",\n",
    "]\n",
    "\n",
    "\n",
    "def normalize_boolean_series(series):\n",
    "    \"\"\"Convert common string and numeric representations to Boolean.\"\"\"\n",
    "\n",
    "    return (\n",
    "        series.astype(str)\n",
    "        .str.strip()\n",
    "        .str.lower()\n",
    "        .map(\n",
    "            {\n",
    "                \"true\": True,\n",
    "                \"false\": False,\n",
    "                \"1\": True,\n",
    "                \"0\": False,\n",
    "            }\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "for dataframe in [\n",
    "    master_df,\n",
    "    train_df,\n",
    "    validation_df,\n",
    "    test_df,\n",
    "]:\n",
    "    for column in BOOLEAN_COLUMNS:\n",
    "        if column in dataframe.columns:\n",
    "            dataframe[column] = normalize_boolean_series(\n",
    "                dataframe[column]\n",
    "            )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 5. FILE-INTEGRITY UTILITIES\n",
    "# =============================================================================\n",
    "\n",
    "def calculate_md5(file_path, chunk_size=1024 * 1024):\n",
    "    \"\"\"Calculate the MD5 checksum of a local file.\"\"\"\n",
    "\n",
    "    digest = hashlib.md5()\n",
    "\n",
    "    with open(file_path, \"rb\") as file:\n",
    "        while True:\n",
    "            chunk = file.read(chunk_size)\n",
    "\n",
    "            if not chunk:\n",
    "                break\n",
    "\n",
    "            digest.update(chunk)\n",
    "\n",
    "    return digest.hexdigest()\n",
    "\n",
    "\n",
    "def resolve_training_path(relative_or_absolute_path):\n",
    "    \"\"\"Resolve a stored training-image path.\"\"\"\n",
    "\n",
    "    path = Path(str(relative_or_absolute_path).strip())\n",
    "\n",
    "    if path.is_absolute():\n",
    "        return path\n",
    "\n",
    "    return VLM_DATASET_DIR / path\n",
    "\n",
    "\n",
    "def inspect_png(image_path):\n",
    "    \"\"\"Return PNG readability and image characteristics.\"\"\"\n",
    "\n",
    "    result = {\n",
    "        \"exists\": False,\n",
    "        \"readable\": False,\n",
    "        \"format\": \"\",\n",
    "        \"mode\": \"\",\n",
    "        \"width\": 0,\n",
    "        \"height\": 0,\n",
    "        \"size_bytes\": 0,\n",
    "        \"md5\": \"\",\n",
    "        \"error\": \"\",\n",
    "    }\n",
    "\n",
    "    try:\n",
    "        image_path = Path(image_path)\n",
    "        result[\"exists\"] = image_path.exists()\n",
    "\n",
    "        if not result[\"exists\"]:\n",
    "            result[\"error\"] = \"File does not exist.\"\n",
    "            return result\n",
    "\n",
    "        result[\"size_bytes\"] = int(\n",
    "            image_path.stat().st_size\n",
    "        )\n",
    "\n",
    "        result[\"md5\"] = calculate_md5(image_path)\n",
    "\n",
    "        with Image.open(image_path) as image:\n",
    "            image.load()\n",
    "\n",
    "            result[\"readable\"] = True\n",
    "            result[\"format\"] = str(image.format)\n",
    "            result[\"mode\"] = str(image.mode)\n",
    "            result[\"width\"] = int(image.width)\n",
    "            result[\"height\"] = int(image.height)\n",
    "\n",
    "        return result\n",
    "\n",
    "    except Exception as exc:\n",
    "        result[\"error\"] = str(exc)\n",
    "        return result\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 6. VERIFY UNIQUE SCENE IMAGES\n",
    "# =============================================================================\n",
    "\n",
    "unique_scene_images_df = (\n",
    "    master_df[\n",
    "        [\n",
    "            \"scene_id\",\n",
    "            \"training_s2_relative_path\",\n",
    "            \"training_s1_relative_path\",\n",
    "        ]\n",
    "    ]\n",
    "    .drop_duplicates(subset=[\"scene_id\"])\n",
    "    .sort_values(\"scene_id\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "image_integrity_records = []\n",
    "\n",
    "print(\"\\nVERIFYING TRAINING IMAGES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for scene_number, row in enumerate(\n",
    "    unique_scene_images_df.itertuples(index=False),\n",
    "    start=1,\n",
    "):\n",
    "    s2_path = resolve_training_path(\n",
    "        row.training_s2_relative_path\n",
    "    )\n",
    "\n",
    "    s1_path = resolve_training_path(\n",
    "        row.training_s1_relative_path\n",
    "    )\n",
    "\n",
    "    s2_result = inspect_png(s2_path)\n",
    "    s1_result = inspect_png(s1_path)\n",
    "\n",
    "    scene_ready = bool(\n",
    "        s2_result[\"exists\"]\n",
    "        and s2_result[\"readable\"]\n",
    "        and s2_result[\"format\"] == \"PNG\"\n",
    "        and s2_result[\"mode\"] == \"RGB\"\n",
    "        and s2_result[\"width\"] == 512\n",
    "        and s2_result[\"height\"] == 512\n",
    "        and s1_result[\"exists\"]\n",
    "        and s1_result[\"readable\"]\n",
    "        and s1_result[\"format\"] == \"PNG\"\n",
    "        and s1_result[\"mode\"] == \"RGB\"\n",
    "        and s1_result[\"width\"] == 512\n",
    "        and s1_result[\"height\"] == 512\n",
    "    )\n",
    "\n",
    "    image_integrity_records.append(\n",
    "        {\n",
    "            \"scene_id\": row.scene_id,\n",
    "            \"s2_path\": str(s2_path),\n",
    "            \"s2_exists\": s2_result[\"exists\"],\n",
    "            \"s2_readable\": s2_result[\"readable\"],\n",
    "            \"s2_format\": s2_result[\"format\"],\n",
    "            \"s2_mode\": s2_result[\"mode\"],\n",
    "            \"s2_width\": s2_result[\"width\"],\n",
    "            \"s2_height\": s2_result[\"height\"],\n",
    "            \"s2_size_bytes\": s2_result[\"size_bytes\"],\n",
    "            \"s2_md5\": s2_result[\"md5\"],\n",
    "            \"s2_error\": s2_result[\"error\"],\n",
    "            \"s1_path\": str(s1_path),\n",
    "            \"s1_exists\": s1_result[\"exists\"],\n",
    "            \"s1_readable\": s1_result[\"readable\"],\n",
    "            \"s1_format\": s1_result[\"format\"],\n",
    "            \"s1_mode\": s1_result[\"mode\"],\n",
    "            \"s1_width\": s1_result[\"width\"],\n",
    "            \"s1_height\": s1_result[\"height\"],\n",
    "            \"s1_size_bytes\": s1_result[\"size_bytes\"],\n",
    "            \"s1_md5\": s1_result[\"md5\"],\n",
    "            \"s1_error\": s1_result[\"error\"],\n",
    "            \"scene_image_integrity_passed\": scene_ready,\n",
    "        }\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[{scene_number:02d}/25] {row.scene_id:<20} \"\n",
    "        f\"| S2: {s2_result['readable']} \"\n",
    "        f\"| S1: {s1_result['readable']} \"\n",
    "        f\"| Ready: {scene_ready}\"\n",
    "    )\n",
    "\n",
    "image_integrity_df = pd.DataFrame(\n",
    "    image_integrity_records\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 7. RECORD-LEVEL INTEGRITY CHECKS\n",
    "# =============================================================================\n",
    "\n",
    "required_record_columns = [\n",
    "    \"instruction_id\",\n",
    "    \"scene_id\",\n",
    "    \"task_family_normalized\",\n",
    "    \"instruction_text\",\n",
    "    \"response_text\",\n",
    "    \"multimodal_prompt\",\n",
    "    \"training_s2_relative_path\",\n",
    "    \"training_s1_relative_path\",\n",
    "    \"split\",\n",
    "    \"training_ready\",\n",
    "]\n",
    "\n",
    "missing_record_columns = [\n",
    "    column\n",
    "    for column in required_record_columns\n",
    "    if column not in master_df.columns\n",
    "]\n",
    "\n",
    "if missing_record_columns:\n",
    "    raise ValueError(\n",
    "        \"Final master dataset is missing required columns: \"\n",
    "        + \", \".join(missing_record_columns)\n",
    "    )\n",
    "\n",
    "record_integrity_df = master_df[\n",
    "    [\n",
    "        \"instruction_id\",\n",
    "        \"scene_id\",\n",
    "        \"task_family_normalized\",\n",
    "        \"split\",\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "record_integrity_df[\"instruction_id_present\"] = (\n",
    "    master_df[\"instruction_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .ne(\"\")\n",
    ")\n",
    "\n",
    "record_integrity_df[\"scene_id_present\"] = (\n",
    "    master_df[\"scene_id\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .ne(\"\")\n",
    ")\n",
    "\n",
    "record_integrity_df[\"task_family_present\"] = (\n",
    "    master_df[\"task_family_normalized\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .ne(\"\")\n",
    ")\n",
    "\n",
    "record_integrity_df[\"instruction_present\"] = (\n",
    "    master_df[\"instruction_text\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .ne(\"\")\n",
    ")\n",
    "\n",
    "record_integrity_df[\"response_present\"] = (\n",
    "    master_df[\"response_text\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .ne(\"\")\n",
    ")\n",
    "\n",
    "record_integrity_df[\"multimodal_prompt_present\"] = (\n",
    "    master_df[\"multimodal_prompt\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .ne(\"\")\n",
    ")\n",
    "\n",
    "record_integrity_df[\"valid_split\"] = (\n",
    "    master_df[\"split\"].isin(\n",
    "        [\"train\", \"validation\", \"test\"]\n",
    "    )\n",
    ")\n",
    "\n",
    "record_integrity_df[\"training_ready\"] = (\n",
    "    master_df[\"training_ready\"].fillna(False)\n",
    ")\n",
    "\n",
    "record_integrity_df[\"record_integrity_passed\"] = (\n",
    "    record_integrity_df[\n",
    "        [\n",
    "            \"instruction_id_present\",\n",
    "            \"scene_id_present\",\n",
    "            \"task_family_present\",\n",
    "            \"instruction_present\",\n",
    "            \"response_present\",\n",
    "            \"multimodal_prompt_present\",\n",
    "            \"valid_split\",\n",
    "            \"training_ready\",\n",
    "        ]\n",
    "    ].all(axis=1)\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 8. SPLIT-LEVEL DISTRIBUTION CHECKS\n",
    "# =============================================================================\n",
    "\n",
    "split_distribution_df = (\n",
    "    master_df.groupby(\n",
    "        [\n",
    "            \"split\",\n",
    "            \"task_family_normalized\",\n",
    "        ],\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        instruction_count=(\"instruction_id\", \"count\"),\n",
    "        scene_count=(\"scene_id\", \"nunique\"),\n",
    "    )\n",
    "    .rename(\n",
    "        columns={\n",
    "            \"task_family_normalized\": \"task_family\",\n",
    "        }\n",
    "    )\n",
    ")\n",
    "\n",
    "expected_task_count_by_split = {\n",
    "    \"train\": 17,\n",
    "    \"validation\": 4,\n",
    "    \"test\": 4,\n",
    "}\n",
    "\n",
    "split_distribution_df[\"expected_instruction_count\"] = (\n",
    "    split_distribution_df[\"split\"]\n",
    "    .map(expected_task_count_by_split)\n",
    ")\n",
    "\n",
    "split_distribution_df[\"balanced_as_expected\"] = (\n",
    "    split_distribution_df[\"instruction_count\"]\n",
    "    == split_distribution_df[\n",
    "        \"expected_instruction_count\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "scene_split_counts = (\n",
    "    scene_split_df.groupby(\"split\")\n",
    "    [\"scene_id\"]\n",
    "    .nunique()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 9. DUPLICATE AND LEAKAGE CHECKS\n",
    "# =============================================================================\n",
    "\n",
    "train_scenes = set(train_df[\"scene_id\"])\n",
    "validation_scenes = set(validation_df[\"scene_id\"])\n",
    "test_scenes = set(test_df[\"scene_id\"])\n",
    "\n",
    "duplicate_instruction_ids = master_df.loc[\n",
    "    master_df[\"instruction_id\"].duplicated(\n",
    "        keep=False\n",
    "    ),\n",
    "    \"instruction_id\",\n",
    "].tolist()\n",
    "\n",
    "duplicate_scene_task_pairs = master_df.loc[\n",
    "    master_df.duplicated(\n",
    "        subset=[\n",
    "            \"scene_id\",\n",
    "            \"task_family_normalized\",\n",
    "        ],\n",
    "        keep=False,\n",
    "    ),\n",
    "    [\n",
    "        \"scene_id\",\n",
    "        \"task_family_normalized\",\n",
    "    ],\n",
    "]\n",
    "\n",
    "scene_overlap = {\n",
    "    \"train_validation\": sorted(\n",
    "        train_scenes & validation_scenes\n",
    "    ),\n",
    "    \"train_test\": sorted(\n",
    "        train_scenes & test_scenes\n",
    "    ),\n",
    "    \"validation_test\": sorted(\n",
    "        validation_scenes & test_scenes\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 10. FINAL VALIDATION CHECKS\n",
    "# =============================================================================\n",
    "\n",
    "instructions_per_scene = (\n",
    "    master_df.groupby(\"scene_id\").size()\n",
    ")\n",
    "\n",
    "task_families_per_scene = (\n",
    "    master_df.groupby(\"scene_id\")[\n",
    "        \"task_family_normalized\"\n",
    "    ].nunique()\n",
    ")\n",
    "\n",
    "final_validation_checks = {\n",
    "    \"master_record_count_is_150\": (\n",
    "        len(master_df) == 150\n",
    "    ),\n",
    "    \"master_scene_count_is_positive\": (\n",
    "        master_df[\"scene_id\"].nunique() == 25\n",
    "    ),\n",
    "    \"task_family_count_is_6\": (\n",
    "        master_df[\n",
    "            \"task_family_normalized\"\n",
    "        ].nunique() == 6\n",
    "    ),\n",
    "    \"instruction_ids_unique\": (\n",
    "        len(duplicate_instruction_ids) == 0\n",
    "    ),\n",
    "    \"scene_task_pairs_unique\": (\n",
    "        len(duplicate_scene_task_pairs) == 0\n",
    "    ),\n",
    "    \"six_instructions_per_scene\": bool(\n",
    "        (instructions_per_scene == 6).all()\n",
    "    ),\n",
    "    \"six_task_families_per_scene\": bool(\n",
    "        (task_families_per_scene == 6).all()\n",
    "    ),\n",
    "    \"train_scene_count_is_17\": (\n",
    "        len(train_scenes) == 17\n",
    "    ),\n",
    "    \"validation_scene_count_is_4\": (\n",
    "        len(validation_scenes) == 4\n",
    "    ),\n",
    "    \"test_scene_count_is_4\": (\n",
    "        len(test_scenes) == 4\n",
    "    ),\n",
    "    \"train_record_count_is_102\": (\n",
    "        len(train_df) == 102\n",
    "    ),\n",
    "    \"validation_record_count_is_24\": (\n",
    "        len(validation_df) == 24\n",
    "    ),\n",
    "    \"test_record_count_is_24\": (\n",
    "        len(test_df) == 24\n",
    "    ),\n",
    "    \"no_scene_leakage\": bool(\n",
    "        not scene_overlap[\"train_validation\"]\n",
    "        and not scene_overlap[\"train_test\"]\n",
    "        and not scene_overlap[\"validation_test\"]\n",
    "    ),\n",
    "    \"all_records_pass_integrity\": bool(\n",
    "        record_integrity_df[\n",
    "            \"record_integrity_passed\"\n",
    "        ].all()\n",
    "    ),\n",
    "    \"all_25_s2_images_valid\": bool(\n",
    "        image_integrity_df[\"s2_readable\"].sum()\n",
    "        == 25\n",
    "    ),\n",
    "    \"all_25_s1_images_valid\": bool(\n",
    "        image_integrity_df[\"s1_readable\"].sum()\n",
    "        == 25\n",
    "    ),\n",
    "    \"all_scene_images_pass_integrity\": bool(\n",
    "        image_integrity_df[\n",
    "            \"scene_image_integrity_passed\"\n",
    "        ].all()\n",
    "    ),\n",
    "    \"all_split_task_distributions_balanced\": bool(\n",
    "        split_distribution_df[\n",
    "            \"balanced_as_expected\"\n",
    "        ].all()\n",
    "    ),\n",
    "    \"all_records_training_ready\": bool(\n",
    "        master_df[\"training_ready\"].all()\n",
    "    ),\n",
    "}\n",
    "\n",
    "final_validation_df = pd.DataFrame(\n",
    "    {\n",
    "        \"validation_check\": (\n",
    "            final_validation_checks.keys()\n",
    "        ),\n",
    "        \"passed\": (\n",
    "            final_validation_checks.values()\n",
    "        ),\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 11. DATASET STATISTICS\n",
    "# =============================================================================\n",
    "\n",
    "dataset_statistics = {\n",
    "    \"record_count\": int(len(master_df)),\n",
    "    \"scene_count\": int(\n",
    "        master_df[\"scene_id\"].nunique()\n",
    "    ),\n",
    "    \"task_family_count\": int(\n",
    "        master_df[\n",
    "            \"task_family_normalized\"\n",
    "        ].nunique()\n",
    "    ),\n",
    "    \"instructions_per_scene\": 6,\n",
    "    \"images_per_instruction\": 2,\n",
    "    \"unique_sentinel2_images\": int(\n",
    "        image_integrity_df[\"scene_id\"].nunique()\n",
    "    ),\n",
    "    \"unique_sentinel1_images\": int(\n",
    "        image_integrity_df[\"scene_id\"].nunique()\n",
    "    ),\n",
    "    \"train_scene_count\": int(len(train_scenes)),\n",
    "    \"train_record_count\": int(len(train_df)),\n",
    "    \"validation_scene_count\": int(\n",
    "        len(validation_scenes)\n",
    "    ),\n",
    "    \"validation_record_count\": int(\n",
    "        len(validation_df)\n",
    "    ),\n",
    "    \"test_scene_count\": int(len(test_scenes)),\n",
    "    \"test_record_count\": int(len(test_df)),\n",
    "    \"total_s2_image_size_mb\": round(\n",
    "        image_integrity_df[\n",
    "            \"s2_size_bytes\"\n",
    "        ].sum()\n",
    "        / (1024 ** 2),\n",
    "        4,\n",
    "    ),\n",
    "    \"total_s1_image_size_mb\": round(\n",
    "        image_integrity_df[\n",
    "            \"s1_size_bytes\"\n",
    "        ].sum()\n",
    "        / (1024 ** 2),\n",
    "        4,\n",
    "    ),\n",
    "}\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 12. CREATE DATASET CARD\n",
    "# =============================================================================\n",
    "\n",
    "task_family_counts = (\n",
    "    master_df[\n",
    "        \"task_family_normalized\"\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .sort_index()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "country_counts = (\n",
    "    master_df.assign(\n",
    "        country=(\n",
    "            master_df[\"scene_id\"]\n",
    "            .astype(str)\n",
    "            .str.split(\"_\")\n",
    "            .str[0]\n",
    "        )\n",
    "    )\n",
    "    .drop_duplicates(subset=[\"scene_id\"])\n",
    "    [\"country\"]\n",
    "    .value_counts()\n",
    "    .sort_index()\n",
    "    .to_dict()\n",
    ")\n",
    "\n",
    "dataset_card_text = f\"\"\"# RoadFlood-VLM Dataset\n",
    "\n",
    "## Dataset Summary\n",
    "\n",
    "RoadFlood-VLM is a multimodal visual instruction dataset for grounded\n",
    "assessment of flood impacts on roadway transportation networks.\n",
    "\n",
    "The dataset combines:\n",
    "\n",
    "- Sentinel-2 true-color optical imagery;\n",
    "- Sentinel-1 radar polarization visualizations;\n",
    "- flood-grounding information;\n",
    "- transportation-network vulnerability information;\n",
    "- reliability-aware natural-language instructions and responses.\n",
    "\n",
    "## Dataset Size\n",
    "\n",
    "- Total instruction records: {dataset_statistics[\"record_count\"]}\n",
    "- Unique flood scenes: {dataset_statistics[\"scene_count\"]}\n",
    "- Task families: {dataset_statistics[\"task_family_count\"]}\n",
    "- Instructions per scene: {dataset_statistics[\"instructions_per_scene\"]}\n",
    "- Images per instruction: {dataset_statistics[\"images_per_instruction\"]}\n",
    "- Unique Sentinel-2 images: {dataset_statistics[\"unique_sentinel2_images\"]}\n",
    "- Unique Sentinel-1 images: {dataset_statistics[\"unique_sentinel1_images\"]}\n",
    "\n",
    "## Dataset Splits\n",
    "\n",
    "Splits are grouped by scene to prevent image and geographic leakage.\n",
    "\n",
    "| Split | Scenes | Instruction Records |\n",
    "|---|---:|---:|\n",
    "| Train | {dataset_statistics[\"train_scene_count\"]} | {dataset_statistics[\"train_record_count\"]} |\n",
    "| Validation | {dataset_statistics[\"validation_scene_count\"]} | {dataset_statistics[\"validation_record_count\"]} |\n",
    "| Test | {dataset_statistics[\"test_scene_count\"]} | {dataset_statistics[\"test_record_count\"]} |\n",
    "\n",
    "Random seed: 42.\n",
    "\n",
    "## Task Families\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "for task_family, count in task_family_counts.items():\n",
    "    dataset_card_text += (\n",
    "        f\"- `{task_family}`: {count} records\\n\"\n",
    "    )\n",
    "\n",
    "dataset_card_text += \"\"\"\n",
    "## Image Products\n",
    "\n",
    "### Sentinel-2\n",
    "\n",
    "The primary optical image is a true-color RGB PNG generated from:\n",
    "\n",
    "- Red: Sentinel-2 Band 4\n",
    "- Green: Sentinel-2 Band 3\n",
    "- Blue: Sentinel-2 Band 2\n",
    "\n",
    "Each band is independently stretched using the 2nd and 98th percentiles and\n",
    "converted to an 8-bit RGB image.\n",
    "\n",
    "### Sentinel-1\n",
    "\n",
    "The radar visualization is an RGB PNG generated from:\n",
    "\n",
    "- Red: source Band 1\n",
    "- Green: source Band 2\n",
    "- Blue: Band 1 minus Band 2\n",
    "\n",
    "The source scientific GeoTIFF files remain unchanged.\n",
    "\n",
    "## Countries and Regions\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "for country, count in country_counts.items():\n",
    "    dataset_card_text += (\n",
    "        f\"- {country}: {count} scenes\\n\"\n",
    "    )\n",
    "\n",
    "dataset_card_text += \"\"\"\n",
    "## Record Structure\n",
    "\n",
    "Each record includes:\n",
    "\n",
    "- instruction identifier;\n",
    "- scene identifier;\n",
    "- task family;\n",
    "- Sentinel-2 image path;\n",
    "- Sentinel-1 image path;\n",
    "- grounded user instruction;\n",
    "- reference response;\n",
    "- scene flood-burden category;\n",
    "- critical-network disruption category;\n",
    "- grounding-reliability category;\n",
    "- train, validation, or test split.\n",
    "\n",
    "## Grounding and Reliability\n",
    "\n",
    "The responses are derived from structured flood-grounding and\n",
    "transportation-network analysis. Reliability labels indicate the strength\n",
    "of the available spatial and transportation evidence.\n",
    "\n",
    "The dataset should not be interpreted as a substitute for field inspection,\n",
    "emergency-management verification, or operational roadway-closure data.\n",
    "\n",
    "## Intended Uses\n",
    "\n",
    "The dataset supports research involving:\n",
    "\n",
    "- multimodal flood-impact assessment;\n",
    "- roadway-network vulnerability reasoning;\n",
    "- transportation disruption prioritization;\n",
    "- reliability-aware visual reasoning;\n",
    "- grounded visual instruction tuning;\n",
    "- comparison of optical-only, radar-only, and multimodal configurations.\n",
    "\n",
    "## Limitations\n",
    "\n",
    "- The dataset contains 25 unique scenes and is therefore suitable primarily\n",
    "  for prototype development and controlled experimentation.\n",
    "- Natural-language records derived from the same scene are related and must\n",
    "  remain within the same split.\n",
    "- RGB visualizations do not preserve all information available in the raw\n",
    "  multispectral and radar GeoTIFFs.\n",
    "- Transportation impacts are grounded estimates and not verified real-time\n",
    "  roadway operational conditions.\n",
    "- Geographic coverage is not globally representative.\n",
    "\n",
    "## Source Data\n",
    "\n",
    "The imagery originates from the SEN1Floods11 hand-labeled flood dataset.\n",
    "\n",
    "Users should review the source dataset's licensing, attribution, and usage\n",
    "requirements before redistributing imagery or derived products.\n",
    "\n",
    "## Dataset Version\n",
    "\n",
    "- RoadFlood-VLM dataset version: v1.0\n",
    "- Transportation-flood grounding version: v1.1\n",
    "- Instruction-generation version: v1.0\n",
    "- Scene-split random seed: 42\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 13. SAVE FINAL OUTPUTS\n",
    "# =============================================================================\n",
    "\n",
    "FINAL_VALIDATION_PATH = (\n",
    "    VALIDATION_DIR\n",
    "    / \"notebook_08_final_integrity_validation.csv\"\n",
    ")\n",
    "\n",
    "IMAGE_INTEGRITY_PATH = (\n",
    "    VALIDATION_DIR\n",
    "    / \"notebook_08_image_integrity.csv\"\n",
    ")\n",
    "\n",
    "RECORD_INTEGRITY_PATH = (\n",
    "    VALIDATION_DIR\n",
    "    / \"notebook_08_record_integrity.csv\"\n",
    ")\n",
    "\n",
    "SPLIT_DISTRIBUTION_PATH = (\n",
    "    VALIDATION_DIR\n",
    "    / \"notebook_08_final_split_distribution.csv\"\n",
    ")\n",
    "\n",
    "DATASET_CARD_PATH = (\n",
    "    DOCUMENTATION_DIR\n",
    "    / \"ROADFLOOD_VLM_DATASET_CARD.md\"\n",
    ")\n",
    "\n",
    "DATASET_STATISTICS_PATH = (\n",
    "    MASTER_DIR\n",
    "    / \"roadflood_vlm_dataset_statistics.json\"\n",
    ")\n",
    "\n",
    "FINAL_COMPLETION_PATH = (\n",
    "    MASTER_DIR\n",
    "    / \"notebook_08_completion_summary.json\"\n",
    ")\n",
    "\n",
    "\n",
    "final_validation_df.to_csv(\n",
    "    FINAL_VALIDATION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "image_integrity_df.to_csv(\n",
    "    IMAGE_INTEGRITY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "record_integrity_df.to_csv(\n",
    "    RECORD_INTEGRITY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "split_distribution_df.to_csv(\n",
    "    SPLIT_DISTRIBUTION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with open(\n",
    "    DATASET_CARD_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    file.write(dataset_card_text)\n",
    "\n",
    "with open(\n",
    "    DATASET_STATISTICS_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        dataset_statistics,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "completion_payload = {\n",
    "    \"notebook\": \"08_build_vlm_dataset\",\n",
    "    \"dataset_name\": \"RoadFlood-VLM\",\n",
    "    \"dataset_version\": \"v1.0\",\n",
    "    \"source_grounding_version\": \"v1.1\",\n",
    "    \"instruction_generation_version\": \"v1.0\",\n",
    "    \"completion_timestamp_utc\": (\n",
    "        datetime.now(timezone.utc).isoformat()\n",
    "    ),\n",
    "    \"stage_status\": {\n",
    "        \"source_manifest_setup\": \"complete\",\n",
    "        \"model_ready_image_generation\": \"complete\",\n",
    "        \"training_dataset_construction\": \"complete\",\n",
    "        \"scene_grouped_splitting\": \"complete\",\n",
    "        \"final_integrity_validation\": (\n",
    "            \"complete\"\n",
    "            if all(final_validation_checks.values())\n",
    "            else \"failed\"\n",
    "        ),\n",
    "    },\n",
    "    \"dataset_statistics\": dataset_statistics,\n",
    "    \"task_family_counts\": {\n",
    "        key: int(value)\n",
    "        for key, value in task_family_counts.items()\n",
    "    },\n",
    "    \"country_scene_counts\": {\n",
    "        key: int(value)\n",
    "        for key, value in country_counts.items()\n",
    "    },\n",
    "    \"split_scene_assignments\": {\n",
    "        \"train\": sorted(train_scenes),\n",
    "        \"validation\": sorted(validation_scenes),\n",
    "        \"test\": sorted(test_scenes),\n",
    "    },\n",
    "    \"scene_overlap\": scene_overlap,\n",
    "    \"validation_results\": {\n",
    "        key: bool(value)\n",
    "        for key, value in final_validation_checks.items()\n",
    "    },\n",
    "    \"output_formats\": [\n",
    "        \"master CSV\",\n",
    "        \"master JSON\",\n",
    "        \"master JSONL\",\n",
    "        \"Qwen2.5-VL JSONL\",\n",
    "        \"LLaVA JSON\",\n",
    "        \"Hugging Face JSONL\",\n",
    "    ],\n",
    "    \"overall_status\": (\n",
    "        \"complete\"\n",
    "        if all(final_validation_checks.values())\n",
    "        else \"failed_validation\"\n",
    "    ),\n",
    "    \"next_notebook\": \"09_vlm_baselines.ipynb\",\n",
    "}\n",
    "\n",
    "with open(\n",
    "    FINAL_COMPLETION_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        completion_payload,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 14. FINAL REPORT\n",
    "# =============================================================================\n",
    "\n",
    "print(\"\\nFINAL INTEGRITY VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for check_name, passed in final_validation_checks.items():\n",
    "    print(f\"{check_name:<46}: {passed}\")\n",
    "\n",
    "print(\"\\nDATASET STATISTICS\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for statistic_name, statistic_value in dataset_statistics.items():\n",
    "    print(\n",
    "        f\"{statistic_name:<34}: \"\n",
    "        f\"{statistic_value}\"\n",
    "    )\n",
    "\n",
    "print(\"\\nFINAL OUTPUT FILES\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for output_path in [\n",
    "    FINAL_VALIDATION_PATH,\n",
    "    IMAGE_INTEGRITY_PATH,\n",
    "    RECORD_INTEGRITY_PATH,\n",
    "    SPLIT_DISTRIBUTION_PATH,\n",
    "    DATASET_CARD_PATH,\n",
    "    DATASET_STATISTICS_PATH,\n",
    "    FINAL_COMPLETION_PATH,\n",
    "]:\n",
    "    print(output_path)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"NOTEBOOK 08 COMPLETE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(f\"Dataset name           : RoadFlood-VLM\")\n",
    "print(f\"Dataset version        : v1.0\")\n",
    "print(f\"Instruction records    : {len(master_df):,}\")\n",
    "print(\n",
    "    f\"Unique scenes          : \"\n",
    "    f\"{master_df['scene_id'].nunique():,}\"\n",
    ")\n",
    "print(\n",
    "    f\"Sentinel-2 images      : \"\n",
    "    f\"{image_integrity_df['s2_readable'].sum():,}\"\n",
    ")\n",
    "print(\n",
    "    f\"Sentinel-1 images      : \"\n",
    "    f\"{image_integrity_df['s1_readable'].sum():,}\"\n",
    ")\n",
    "print(f\"Training records       : {len(train_df):,}\")\n",
    "print(f\"Validation records     : {len(validation_df):,}\")\n",
    "print(f\"Test records           : {len(test_df):,}\")\n",
    "print(\n",
    "    f\"Scene leakage          : \"\n",
    "    f\"{not final_validation_checks['no_scene_leakage']}\"\n",
    ")\n",
    "print(\n",
    "    f\"Overall notebook status: \"\n",
    "    f\"{completion_payload['overall_status']}\"\n",
    ")\n",
    "\n",
    "if not all(final_validation_checks.values()):\n",
    "    failed_checks = [\n",
    "        check_name\n",
    "        for check_name, passed\n",
    "        in final_validation_checks.items()\n",
    "        if not passed\n",
    "    ]\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Notebook 08 failed final validation checks: \"\n",
    "        + \", \".join(failed_checks)\n",
    "    )\n",
    "\n",
    "print(\"\\nNEXT STEP\")\n",
    "print(\"-\" * 80)\n",
    "print(\n",
    "    \"Notebook 08 is complete. Proceed to \"\n",
    "    \"09_vlm_baselines.ipynb to evaluate zero-shot and prompt-based \"\n",
    "    \"multimodal baselines before fine-tuning.\"\n",
    ")\n",
    "\n",
    "print(\"=\" * 80)"
   ]
  },
