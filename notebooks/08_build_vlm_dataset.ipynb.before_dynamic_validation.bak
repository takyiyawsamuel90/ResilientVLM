      "total_record_count_is_150                     : True\n",
      "no_train_validation_scene_overlap             : True\n",
      "no_train_test_scene_overlap                   : True\n",
      "no_validation_test_scene_overlap              : True\n",
      "all_scenes_assigned_once                      : True\n",
      "six_records_per_scene_preserved               : True\n",
      "all_splits_have_six_task_families             : True\n",
      "all_records_training_ready                    : True\n",
      "\n",
      "SPLIT SUMMARY\n",
      "--------------------------------------------------------------------------------\n",
      "     split  scene_count  instruction_count  task_family_count  training_ready_count\n",
      "      test            4                 24                  6                    24\n",
      "     train           17                102                  6                   102\n",
      "validation            4                 24                  6                    24\n",
      "\n",
      "SCENE ASSIGNMENTS\n",
      "--------------------------------------------------------------------------------\n",
      "TRAIN     : 17 scenes\n",
      "['Ghana_141910', 'India_1018327', 'India_1050276', 'India_285297', 'India_500266', 'India_804466', 'India_956930', 'Mekong_16233', 'Nigeria_598959', 'Somalia_322855', 'Somalia_970508', 'Spain_1167260', 'Spain_7370579', 'Spain_8565131', 'Sri-Lanka_14484', 'Sri-Lanka_92824', 'USA_170264']\n",
      "VALIDATION: 4 scenes\n",
      "['Nigeria_1095404', 'USA_217598', 'USA_86502', 'USA_955053']\n",
      "TEST      : 4 scenes\n",
      "['India_1068117', 'India_383430', 'India_943439', 'USA_1068362']\n",
      "\n",
      "================================================================================\n",
      "SCENE-GROUPED DATASET SPLITS COMPLETE\n",
      "================================================================================\n",
      "Training scenes       : 17\n",
      "Training records      : 102\n",
      "Validation scenes     : 4\n",
      "Validation records    : 24\n",
      "Test scenes           : 4\n",
      "Test records          : 24\n",
      "Scene leakage         : False\n",
      "Overall split status  : complete\n",
      "\n",
      "NEXT STEP\n",
