   ],
   "source": [
    "# =============================================================================\n",
    "# NOTEBOOK 08 — CELL 4\n",
    "# CREATE SCENE-GROUPED TRAIN / VALIDATION / TEST SPLITS\n",
    "# =============================================================================\n",
    "\n",
    "from pathlib import Path\n",
    "import json\n",
    "import random\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 1. PATHS AND CONFIGURATION\n",
    "# =============================================================================\n",
    "\n",
    "PROJECT_ROOT = Path(\n",
    "    r\"C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\"\n",
    ")\n",
    "\n",
    "VLM_DATASET_DIR = (\n",
    "    PROJECT_ROOT\n",
    "    / \"data\"\n",
    "    / \"processed\"\n",
    "    / \"vlm_dataset\"\n",
    ")\n",
    "\n",
    "MASTER_DIR = VLM_DATASET_DIR / \"master\"\n",
    "SPLIT_DIR = VLM_DATASET_DIR / \"splits\"\n",
    "QWEN_SPLIT_DIR = SPLIT_DIR / \"qwen\"\n",
    "HF_SPLIT_DIR = SPLIT_DIR / \"huggingface\"\n",
    "VALIDATION_DIR = VLM_DATASET_DIR / \"validation\"\n",
    "\n",
    "MASTER_DATASET_PATH = MASTER_DIR / \"master_vlm_dataset.csv\"\n",
    "\n",
    "for directory in [\n",
    "    SPLIT_DIR,\n",
    "    QWEN_SPLIT_DIR,\n",
    "    HF_SPLIT_DIR,\n",
    "    VALIDATION_DIR,\n",
    "]:\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "RANDOM_SEED = 42\n",
    "\n",
    "# 25 scenes:\n",
    "# 17 train + 4 validation + 4 test\n",
    "TRAIN_SCENE_COUNT = 17\n",
    "VALIDATION_SCENE_COUNT = 4\n",
    "TEST_SCENE_COUNT = 4\n",
    "\n",
    "print(\"=\" * 80)\n",
    "print(\"NOTEBOOK 08: SCENE-GROUPED DATASET SPLITS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(\"\\nCONFIGURATION\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Random seed       : {RANDOM_SEED}\")\n",
    "print(f\"Training scenes   : {TRAIN_SCENE_COUNT}\")\n",
    "print(f\"Validation scenes : {VALIDATION_SCENE_COUNT}\")\n",
    "print(f\"Test scenes       : {TEST_SCENE_COUNT}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 2. LOAD MASTER DATASET\n",
    "# =============================================================================\n",
    "\n",
    "if not MASTER_DATASET_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"Master VLM dataset not found: {MASTER_DATASET_PATH}\"\n",
    "    )\n",
    "\n",
    "master_df = pd.read_csv(\n",
    "    MASTER_DATASET_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "required_columns = [\n",
    "    \"instruction_id\",\n",
    "    \"scene_id\",\n",
    "    \"task_family_normalized\",\n",
    "    \"instruction_text\",\n",
    "    \"response_text\",\n",
    "    \"training_s2_relative_path\",\n",
    "    \"training_s1_relative_path\",\n",
    "    \"training_ready\",\n",
    "]\n",
    "\n",
    "missing_columns = [\n",
    "    column\n",
    "    for column in required_columns\n",
    "    if column not in master_df.columns\n",
    "]\n",
    "\n",
    "if missing_columns:\n",
    "    raise ValueError(\n",
    "        \"Master dataset is missing required columns: \"\n",
    "        + \", \".join(missing_columns)\n",
    "    )\n",
    "\n",
    "master_df[\"training_ready\"] = (\n",
    "    master_df[\"training_ready\"]\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .map({\"true\": True, \"false\": False})\n",
    ")\n",
    "\n",
    "print(\"\\nMASTER DATASET\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"Records       : {len(master_df):,}\")\n",
    "print(f\"Scenes        : {master_df['scene_id'].nunique():,}\")\n",
    "print(\n",
    "    f\"Task families : \"\n",
    "    f\"{master_df['task_family_normalized'].nunique():,}\"\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 3. CREATE SCENE-LEVEL STRATIFICATION TABLE\n",
    "# =============================================================================\n",
    "\n",
    "scene_level_df = (\n",
    "    master_df.groupby(\n",
    "        \"scene_id\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        instruction_count=(\"instruction_id\", \"count\"),\n",
    "        task_family_count=(\n",
    "            \"task_family_normalized\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "        flood_burden=(\n",
    "            \"flood_burden_normalized\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        disruption_level=(\n",
    "            \"disruption_normalized\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        reliability=(\n",
    "            \"reliability_normalized\",\n",
    "            \"first\",\n",
    "        ),\n",
    "        all_records_ready=(\"training_ready\", \"all\"),\n",
    "    )\n",
    ")\n",
    "\n",
    "if len(scene_level_df) != 25:\n",
    "    raise ValueError(\n",
    "        f\"Expected 25 scenes, found {len(scene_level_df)}.\"\n",
    "    )\n",
    "\n",
    "if not scene_level_df[\"all_records_ready\"].all():\n",
    "    bad_scenes = scene_level_df.loc[\n",
    "        ~scene_level_df[\"all_records_ready\"],\n",
    "        \"scene_id\",\n",
    "    ].tolist()\n",
    "\n",
    "    raise ValueError(\n",
    "        f\"Some scenes are not fully training-ready: {bad_scenes}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 4. STRATIFIED SCENE ASSIGNMENT\n",
    "# =============================================================================\n",
    "# This balances scenes using flood burden, disruption, and reliability where\n",
    "# possible while maintaining deterministic, leakage-free splits.\n",
    "\n",
    "scene_level_df[\"stratum\"] = (\n",
    "    scene_level_df[\"flood_burden\"].astype(str)\n",
    "    + \"__\"\n",
    "    + scene_level_df[\"disruption_level\"].astype(str)\n",
    "    + \"__\"\n",
    "    + scene_level_df[\"reliability\"].astype(str)\n",
    ")\n",
    "\n",
    "rng = random.Random(RANDOM_SEED)\n",
    "\n",
    "split_targets = {\n",
    "    \"train\": TRAIN_SCENE_COUNT,\n",
    "    \"validation\": VALIDATION_SCENE_COUNT,\n",
    "    \"test\": TEST_SCENE_COUNT,\n",
    "}\n",
    "\n",
    "split_assignments = {\n",
    "    \"train\": [],\n",
    "    \"validation\": [],\n",
    "    \"test\": [],\n",
    "}\n",
    "\n",
    "# Shuffle within each stratum.\n",
    "stratum_groups = []\n",
    "\n",
    "for stratum, group in scene_level_df.groupby(\"stratum\"):\n",
    "    scene_ids = group[\"scene_id\"].tolist()\n",
    "    rng.shuffle(scene_ids)\n",
    "\n",
    "    stratum_groups.append(\n",
    "        {\n",
    "            \"stratum\": stratum,\n",
    "            \"scene_ids\": scene_ids,\n",
    "        }\n",
    "    )\n",
    "\n",
    "# Process larger strata first.\n",
    "stratum_groups = sorted(\n",
    "    stratum_groups,\n",
    "    key=lambda item: len(item[\"scene_ids\"]),\n",
    "    reverse=True,\n",
    ")\n",
    "\n",
    "for group in stratum_groups:\n",
    "    for scene_id in group[\"scene_ids\"]:\n",
    "\n",
    "        remaining_capacity = {\n",
    "            split_name: (\n",
    "                split_targets[split_name]\n",
    "                - len(split_assignments[split_name])\n",
    "            )\n",
    "            for split_name in split_assignments\n",
    "        }\n",
    "\n",
    "        available_splits = [\n",
    "            split_name\n",
    "            for split_name, capacity\n",
    "            in remaining_capacity.items()\n",
    "            if capacity > 0\n",
    "        ]\n",
    "\n",
    "        if not available_splits:\n",
    "            raise RuntimeError(\n",
    "                \"No split capacity remains while assigning scenes.\"\n",
    "            )\n",
    "\n",
    "        # Prefer the split with the greatest proportional capacity remaining.\n",
    "        selected_split = max(\n",
    "            available_splits,\n",
    "            key=lambda split_name: (\n",
    "                remaining_capacity[split_name]\n",
    "                / split_targets[split_name]\n",
    "            ),\n",
    "        )\n",
    "\n",
    "        split_assignments[selected_split].append(scene_id)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 5. ATTACH SPLIT LABELS\n",
    "# =============================================================================\n",
    "\n",
    "scene_to_split = {}\n",
    "\n",
    "for split_name, scene_ids in split_assignments.items():\n",
    "    for scene_id in scene_ids:\n",
    "        if scene_id in scene_to_split:\n",
    "            raise RuntimeError(\n",
    "                f\"Scene assigned more than once: {scene_id}\"\n",
    "            )\n",
    "\n",
    "        scene_to_split[scene_id] = split_name\n",
    "\n",
    "scene_level_df[\"split\"] = (\n",
    "    scene_level_df[\"scene_id\"]\n",
    "    .map(scene_to_split)\n",
    ")\n",
    "\n",
    "master_split_df = master_df.copy()\n",
    "\n",
    "master_split_df[\"split\"] = (\n",
    "    master_split_df[\"scene_id\"]\n",
    "    .map(scene_to_split)\n",
    ")\n",
    "\n",
    "if master_split_df[\"split\"].eq(\"\").any():\n",
    "    raise RuntimeError(\n",
    "        \"One or more instruction records were not assigned a split.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 6. CREATE SPLIT DATAFRAMES\n",
    "# =============================================================================\n",
    "\n",
    "train_df = (\n",
    "    master_split_df.loc[\n",
    "        master_split_df[\"split\"] == \"train\"\n",
    "    ]\n",
    "    .copy()\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "validation_df = (\n",
    "    master_split_df.loc[\n",
    "        master_split_df[\"split\"] == \"validation\"\n",
    "    ]\n",
    "    .copy()\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "test_df = (\n",
    "    master_split_df.loc[\n",
    "        master_split_df[\"split\"] == \"test\"\n",
    "    ]\n",
    "    .copy()\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 7. BUILD QWEN FORMAT\n",
    "# =============================================================================\n",
    "\n",
    "def build_qwen_records(dataframe):\n",
    "    records = []\n",
    "\n",
    "    for row in dataframe.itertuples(index=False):\n",
    "        records.append(\n",
    "            {\n",
    "                \"id\": row.instruction_id,\n",
    "                \"scene_id\": row.scene_id,\n",
    "                \"task_family\": row.task_family_normalized,\n",
    "                \"messages\": [\n",
    "                    {\n",
    "                        \"role\": \"user\",\n",
    "                        \"content\": [\n",
    "                            {\n",
    "                                \"type\": \"image\",\n",
    "                                \"image\": (\n",
    "                                    row.training_s2_relative_path\n",
    "                                ),\n",
    "                            },\n",
    "                            {\n",
    "                                \"type\": \"image\",\n",
    "                                \"image\": (\n",
    "                                    row.training_s1_relative_path\n",
    "                                ),\n",
    "                            },\n",
    "                            {\n",
    "                                \"type\": \"text\",\n",
    "                                \"text\": row.multimodal_prompt,\n",
    "                            },\n",
    "                        ],\n",
    "                    },\n",
    "                    {\n",
    "                        \"role\": \"assistant\",\n",
    "                        \"content\": [\n",
    "                            {\n",
    "                                \"type\": \"text\",\n",
    "                                \"text\": row.response_text,\n",
    "                            }\n",
    "                        ],\n",
    "                    },\n",
    "                ],\n",
    "                \"metadata\": {\n",
    "                    \"split\": row.split,\n",
    "                    \"scene_flood_burden\": (\n",
    "                        row.flood_burden_normalized\n",
    "                    ),\n",
    "                    \"critical_network_disruption\": (\n",
    "                        row.disruption_normalized\n",
    "                    ),\n",
    "                    \"grounding_reliability\": (\n",
    "                        row.reliability_normalized\n",
    "                    ),\n",
    "                },\n",
    "            }\n",
    "        )\n",
    "\n",
    "    return records\n",
    "\n",
    "\n",
    "qwen_train = build_qwen_records(train_df)\n",
    "qwen_validation = build_qwen_records(validation_df)\n",
    "qwen_test = build_qwen_records(test_df)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 8. BUILD HUGGING FACE JSONL FORMAT\n",
    "# =============================================================================\n",
    "\n",
    "def build_hf_records(dataframe):\n",
    "    records = []\n",
    "\n",
    "    for row in dataframe.itertuples(index=False):\n",
    "        records.append(\n",
    "            {\n",
    "                \"instruction_id\": row.instruction_id,\n",
    "                \"scene_id\": row.scene_id,\n",
    "                \"split\": row.split,\n",
    "                \"task_family\": row.task_family_normalized,\n",
    "                \"images\": [\n",
    "                    row.training_s2_relative_path,\n",
    "                    row.training_s1_relative_path,\n",
    "                ],\n",
    "                \"sentinel2_image\": (\n",
    "                    row.training_s2_relative_path\n",
    "                ),\n",
    "                \"sentinel1_image\": (\n",
    "                    row.training_s1_relative_path\n",
    "                ),\n",
    "                \"instruction\": row.instruction_text,\n",
    "                \"multimodal_prompt\": row.multimodal_prompt,\n",
    "                \"response\": row.response_text,\n",
    "                \"scene_flood_burden\": (\n",
    "                    row.flood_burden_normalized\n",
    "                ),\n",
    "                \"critical_network_disruption\": (\n",
    "                    row.disruption_normalized\n",
    "                ),\n",
    "                \"grounding_reliability\": (\n",
    "                    row.reliability_normalized\n",
    "                ),\n",
    "                \"training_ready\": bool(row.training_ready),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    return records\n",
    "\n",
    "\n",
    "hf_train = build_hf_records(train_df)\n",
    "hf_validation = build_hf_records(validation_df)\n",
    "hf_test = build_hf_records(test_df)\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 9. VALIDATION\n",
    "# =============================================================================\n",
    "\n",
    "train_scenes = set(train_df[\"scene_id\"])\n",
    "validation_scenes = set(validation_df[\"scene_id\"])\n",
    "test_scenes = set(test_df[\"scene_id\"])\n",
    "\n",
    "validation_checks = {\n",
    "    \"total_scene_count_is_positive\": (\n",
    "        len(scene_to_split) == 25\n",
    "    ),\n",
    "    \"train_scene_count_is_17\": (\n",
    "        len(train_scenes) == 17\n",
    "    ),\n",
    "    \"validation_scene_count_is_4\": (\n",
    "        len(validation_scenes) == 4\n",
    "    ),\n",
    "    \"test_scene_count_is_4\": (\n",
    "        len(test_scenes) == 4\n",
    "    ),\n",
    "    \"train_record_count_is_102\": (\n",
    "        len(train_df) == 102\n",
    "    ),\n",
    "    \"validation_record_count_is_24\": (\n",
    "        len(validation_df) == 24\n",
    "    ),\n",
    "    \"test_record_count_is_24\": (\n",
    "        len(test_df) == 24\n",
    "    ),\n",
    "    \"total_record_count_is_150\": (\n",
    "        len(master_split_df) == 150\n",
    "    ),\n",
    "    \"no_train_validation_scene_overlap\": (\n",
    "        len(train_scenes & validation_scenes) == 0\n",
    "    ),\n",
    "    \"no_train_test_scene_overlap\": (\n",
    "        len(train_scenes & test_scenes) == 0\n",
    "    ),\n",
    "    \"no_validation_test_scene_overlap\": (\n",
    "        len(validation_scenes & test_scenes) == 0\n",
    "    ),\n",
    "    \"all_scenes_assigned_once\": (\n",
    "        len(\n",
    "            train_scenes\n",
    "            | validation_scenes\n",
    "            | test_scenes\n",
    "        ) == 25\n",
    "    ),\n",
    "    \"six_records_per_scene_preserved\": bool(\n",
    "        (\n",
    "            master_split_df.groupby(\"scene_id\").size()\n",
    "            == 6\n",
    "        ).all()\n",
    "    ),\n",
    "    \"all_splits_have_six_task_families\": bool(\n",
    "        all(\n",
    "            split_df[\n",
    "                \"task_family_normalized\"\n",
    "            ].nunique() == 6\n",
    "            for split_df in [\n",
    "                train_df,\n",
    "                validation_df,\n",
    "                test_df,\n",
    "            ]\n",
    "        )\n",
    "    ),\n",
    "    \"all_records_training_ready\": bool(\n",
    "        master_split_df[\"training_ready\"].all()\n",
    "    ),\n",
    "}\n",
    "\n",
    "split_validation_df = pd.DataFrame(\n",
    "    {\n",
    "        \"validation_check\": validation_checks.keys(),\n",
    "        \"passed\": validation_checks.values(),\n",
    "    }\n",
    ")\n",
    "\n",
    "split_summary_df = (\n",
    "    master_split_df.groupby(\n",
    "        \"split\",\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        scene_count=(\"scene_id\", \"nunique\"),\n",
    "        instruction_count=(\"instruction_id\", \"count\"),\n",
    "        task_family_count=(\n",
    "            \"task_family_normalized\",\n",
    "            \"nunique\",\n",
    "        ),\n",
    "        training_ready_count=(\"training_ready\", \"sum\"),\n",
    "    )\n",
    ")\n",
    "\n",
    "split_scene_distribution_df = (\n",
    "    scene_level_df.groupby(\n",
    "        [\n",
    "            \"split\",\n",
    "            \"flood_burden\",\n",
    "            \"disruption_level\",\n",
    "            \"reliability\",\n",
    "        ],\n",
    "        as_index=False,\n",
    "    )\n",
    "    .agg(\n",
    "        scene_count=(\"scene_id\", \"count\")\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 10. SAVE OUTPUTS\n",
    "# =============================================================================\n",
    "\n",
    "MASTER_SPLIT_PATH = (\n",
    "    MASTER_DIR / \"master_vlm_dataset_with_splits.csv\"\n",
    ")\n",
    "\n",
    "SCENE_SPLIT_MANIFEST_PATH = (\n",
    "    SPLIT_DIR / \"scene_split_manifest.csv\"\n",
    ")\n",
    "\n",
    "TRAIN_CSV_PATH = SPLIT_DIR / \"train.csv\"\n",
    "VALIDATION_CSV_PATH = SPLIT_DIR / \"validation.csv\"\n",
    "TEST_CSV_PATH = SPLIT_DIR / \"test.csv\"\n",
    "\n",
    "QWEN_TRAIN_PATH = QWEN_SPLIT_DIR / \"train.jsonl\"\n",
    "QWEN_VALIDATION_PATH = QWEN_SPLIT_DIR / \"validation.jsonl\"\n",
    "QWEN_TEST_PATH = QWEN_SPLIT_DIR / \"test.jsonl\"\n",
    "\n",
    "HF_TRAIN_PATH = HF_SPLIT_DIR / \"train.jsonl\"\n",
    "HF_VALIDATION_PATH = HF_SPLIT_DIR / \"validation.jsonl\"\n",
    "HF_TEST_PATH = HF_SPLIT_DIR / \"test.jsonl\"\n",
    "\n",
    "SPLIT_VALIDATION_PATH = (\n",
    "    VALIDATION_DIR / \"scene_split_validation.csv\"\n",
    ")\n",
    "\n",
    "SPLIT_SUMMARY_PATH = (\n",
    "    VALIDATION_DIR / \"scene_split_summary.csv\"\n",
    ")\n",
    "\n",
    "SPLIT_DISTRIBUTION_PATH = (\n",
    "    VALIDATION_DIR / \"scene_split_distribution.csv\"\n",
    ")\n",
    "\n",
    "SPLIT_METADATA_PATH = (\n",
    "    MASTER_DIR / \"notebook_08_split_summary.json\"\n",
    ")\n",
    "\n",
    "\n",
    "master_split_df.to_csv(\n",
    "    MASTER_SPLIT_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "scene_level_df.to_csv(\n",
    "    SCENE_SPLIT_MANIFEST_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "train_df.to_csv(\n",
    "    TRAIN_CSV_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "validation_df.to_csv(\n",
    "    VALIDATION_CSV_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "test_df.to_csv(\n",
    "    TEST_CSV_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "def write_jsonl(records, output_path):\n",
    "    with open(\n",
    "        output_path,\n",
    "        \"w\",\n",
    "        encoding=\"utf-8\",\n",
    "    ) as file:\n",
    "        for record in records:\n",
    "            file.write(\n",
    "                json.dumps(\n",
    "                    record,\n",
    "                    ensure_ascii=False,\n",
    "                )\n",
    "                + \"\\n\"\n",
    "            )\n",
    "\n",
    "\n",
    "write_jsonl(qwen_train, QWEN_TRAIN_PATH)\n",
    "write_jsonl(qwen_validation, QWEN_VALIDATION_PATH)\n",
    "write_jsonl(qwen_test, QWEN_TEST_PATH)\n",
    "\n",
    "write_jsonl(hf_train, HF_TRAIN_PATH)\n",
    "write_jsonl(hf_validation, HF_VALIDATION_PATH)\n",
    "write_jsonl(hf_test, HF_TEST_PATH)\n",
    "\n",
    "split_validation_df.to_csv(\n",
    "    SPLIT_VALIDATION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "split_summary_df.to_csv(\n",
    "    SPLIT_SUMMARY_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "split_scene_distribution_df.to_csv(\n",
    "    SPLIT_DISTRIBUTION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "summary_payload = {\n",
    "    \"notebook\": \"08_build_vlm_dataset\",\n",
    "    \"stage\": \"scene_grouped_dataset_splitting\",\n",
    "    \"dataset_name\": \"RoadFlood-VLM\",\n",
    "    \"dataset_version\": \"v1.0\",\n",
    "    \"random_seed\": RANDOM_SEED,\n",
    "    \"split_strategy\": (\n",
    "        \"scene-grouped deterministic stratified assignment\"\n",
    "    ),\n",
    "    \"train\": {\n",
    "        \"scene_count\": int(len(train_scenes)),\n",
    "        \"instruction_count\": int(len(train_df)),\n",
    "    },\n",
    "    \"validation\": {\n",
    "        \"scene_count\": int(len(validation_scenes)),\n",
    "        \"instruction_count\": int(len(validation_df)),\n",
    "    },\n",
    "    \"test\": {\n",
    "        \"scene_count\": int(len(test_scenes)),\n",
    "        \"instruction_count\": int(len(test_df)),\n",
    "    },\n",
    "    \"scene_leakage\": False,\n",
    "    \"validation_results\": {\n",
    "        key: bool(value)\n",
    "        for key, value in validation_checks.items()\n",
    "    },\n",
    "    \"overall_status\": (\n",
    "        \"complete\"\n",
    "        if all(validation_checks.values())\n",
    "        else \"failed_validation\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "with open(\n",
    "    SPLIT_METADATA_PATH,\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        summary_payload,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# 11. FINAL REPORT\n",
    "# =============================================================================\n",
    "\n",
    "print(\"\\nSCENE-SPLIT VALIDATION\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for check_name, passed in validation_checks.items():\n",
    "    print(f\"{check_name:<46}: {passed}\")\n",
    "\n",
    "print(\"\\nSPLIT SUMMARY\")\n",
    "print(\"-\" * 80)\n",
    "print(split_summary_df.to_string(index=False))\n",
    "\n",
    "print(\"\\nSCENE ASSIGNMENTS\")\n",
    "print(\"-\" * 80)\n",
    "\n",
    "for split_name in [\n",
    "    \"train\",\n",
    "    \"validation\",\n",
    "    \"test\",\n",
    "]:\n",
    "    split_scene_list = sorted(\n",
    "        scene_level_df.loc[\n",
    "            scene_level_df[\"split\"] == split_name,\n",
    "            \"scene_id\",\n",
    "        ].tolist()\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"{split_name.upper():<10}: \"\n",
    "        f\"{len(split_scene_list)} scenes\"\n",
    "    )\n",
    "\n",
    "    print(split_scene_list)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 80)\n",
    "print(\"SCENE-GROUPED DATASET SPLITS COMPLETE\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "print(f\"Training scenes       : {len(train_scenes)}\")\n",
    "print(f\"Training records      : {len(train_df)}\")\n",
    "print(f\"Validation scenes     : {len(validation_scenes)}\")\n",
    "print(f\"Validation records    : {len(validation_df)}\")\n",
    "print(f\"Test scenes           : {len(test_scenes)}\")\n",
    "print(f\"Test records          : {len(test_df)}\")\n",
    "print(\"Scene leakage         : False\")\n",
    "print(\n",
    "    f\"Overall split status  : \"\n",
    "    f\"{summary_payload['overall_status']}\"\n",
    ")\n",
    "\n",
    "print(\"\\nNEXT STEP\")\n",
    "print(\"-\" * 80)\n",
    "print(\n",
    "    \"Proceed to Notebook 08 Cell 5 for final dataset integrity checks, \"\n",
    "    \"dataset-card metadata, and Notebook 08 completion.\"\n",
    ")\n",
    "\n",
    "if not all(validation_checks.values()):\n",
    "    failed_checks = [\n",
    "        key\n",
    "        for key, value in validation_checks.items()\n",
    "        if not value\n",
    "    ]\n",
    "\n",
    "    raise RuntimeError(\n",
    "        \"Scene-grouped dataset splitting failed validation: \"\n",
    "        + \", \".join(failed_checks)\n",
    "    )\n",
    "\n",
    "print(\"=\" * 80)"
   ]
  },
