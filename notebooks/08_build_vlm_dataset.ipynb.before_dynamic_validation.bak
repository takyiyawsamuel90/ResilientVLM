      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\master\\master_vlm_dataset.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\master\\master_vlm_dataset.json\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\master\\master_vlm_dataset.jsonl\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\qwen\\qwen_multimodal_train.json\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\qwen\\qwen_multimodal_train.jsonl\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\llava\\llava_multimodal_train.json\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\huggingface\\roadflood_vlm_dataset.jsonl\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\manifests\\training_image_manifest.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\validation\\training_dataset_validation.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\validation\\training_task_family_summary.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\validation\\training_scene_summary.csv\n",
      "C:\\Users\\takyi\\Desktop\\Machine Learning Engineering\\ResilientVLM\\data\\processed\\vlm_dataset\\master\\notebook_08_dataset_summary.json\n",
